(* #186 P9f: proofs about the program of their own file or module body (reference: meta/index, "Order of
   elaboration"). The declarations that use `programOf here` or `here ⊢ r t̄`, and those that use them, are
   elaborated after the rules of their file or body; inside a functor's body, `here` is the body's program
   at its own parameters, and every instance has the lemmas. *)
%use "std/semantics".
%use "std/quote".
%use "std/eq" (eq, refl, tt).

city : type. berlin, paris, rome : city.
road : city -> city -> rel.
road berlin paris.
road paris rome.
path : city -> city -> rel.
path X Y :- road X Y.
path X Z :- road X Y, path Y Z.
%output path.

(* the file's program: its relations and constants in source order, its rules *)
fileP : program = programOf here.
(* `relationsOf` does not mention `here`, but it uses `fileP`: it is elaborated after the rules too *)
relationsOf : list string = fileP.relations.
names : eq relationsOf ["berlin", "paris", "rome", "road", "path"] = refl.

(* the file's rules by name, at any database *)
trans : {D : db} -> {x y z : ⇑city} -> here ⊢[D] path x y -> here ⊢[D] path y z -> here ⊢[D] path x z.
trans (path.1 R) Q = path.2 R Q.
trans (path.2 R P) Q = path.2 R (trans P Q).
(* by evaluation: three rounds of the file's rules derive the fact *)
viaParis : {D : db} -> here ⊢[D] path berlin rome = decide 3 tt.
%opaque trans viaParis names.

graph2 : Type = { node : type, edge : node -> node -> rel }.

(* inside a functor's body, `here` is `walks g` *)
walks (g : graph2) = {
  walk : g.node -> g.node -> rel.
  walk X Y :- g.edge X Y.
  walk X Z :- walk X Y, walk Y Z.
  edgeWalk : {D : db} -> {x y : ⇑g.node} -> here ⊢[D] g.edge x y -> here ⊢[D] walk x y.
  edgeWalk E = walk.1 E.
  walkTrans : {D : db} -> {x y z : ⇑g.node} -> here ⊢[D] walk x y -> here ⊢[D] walk y z -> here ⊢[D] walk x z.
  walkTrans P Q = walk.2 P Q.
  rules : eq (programOf here).relations ["walk"] = refl.
}.
fast = walks { node = city, edge = road }.
%output fast.walk.

(* the instance's lemma, at the instance's program *)
fastTrans : {D : db} -> {x y z : ⇑city} -> fast ⊢[D] walk x y -> fast ⊢[D] walk y z -> fast ⊢[D] walk x z = fast.walkTrans.
%opaque fastTrans.
