(* The argument of `%use` or `%export` does not start in column 0, like a directive's: a `%use` or
   `%export` at the end of a line without its argument is one error, and the next item is parsed. *)
%use "std/reflect".
person : type. ann : person.
knows : person -> person -> rel.
symmetric : (r : ^(A -> A -> rel)) -> list item. %use
symmetric R = '( R Y X :- R X Y. ). (*~ E0001 *)
%symmetric knows.
knows ann ann.
%export
known : person -> rel. (*~ E0001 *)
known X :- knows X _.
%output knows.
