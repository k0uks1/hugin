(* Lists shared by both stages (issues #52, #80). The prelude's `list` is a shared data type: one
   declaration is a meta inductive family and an object family, and `[a, b]`, `x :: xs` are lists at
   both stages. A list built at compile time is used as object code directly: stage inference inserts
   `list.lift` (the fold into object code) where a meta list is used as an object list, and `list.reify`
   (the fold into reflected syntax) at a hole of a quote. Before #80 this file wrote both folds by hand
   (`lift` into `⇑(list B)`, `reify` into `term`, and a `persist` function for the elements). *)
%use "std/reflect". %use "std/list".

(* The length at compile time; the prelude's `len` is the length of the lists that are facts (the two
   are written differently on purpose: a structural fold and a fixed point over facts). *)
slen : list A -> int.
slen [] = 0.
slen (X :: Xs) = slen Xs + 1.

primes : list int = [2, 3, 5, 7].

held : list int -> rel.
held primes.                                      (* `list.lift` is inserted *)

(* A directive-style generator: one fact per suffix, built as data (a quoted fact is a rule without
   body); the hole `$(X :: Xs)` is a meta list in a quote, so `list.reify` is inserted. *)
suffixes : list int -> list rule.
suffixes [] = [].
suffixes (X :: Xs) = '( held $(X :: Xs) ) :: suffixes Xs.
$suffixes [11, 13].

static_len : int -> rel.
static_len (slen primes).

?- held L, len L N.
%output static_len.
