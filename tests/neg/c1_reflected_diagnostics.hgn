(* Diagnostics in reflected code point to the quoted syntax the code came from, with a note on the item
   that reflected it; a quote that is ill-typed by itself (`typo`) is reported where it is written. *)
p : int -> rel.
q : int -> rel.

mk : int -> list rule.
mk N = '{ p X :- q N. }. (*~ E0501 *)

$mk 1.

typo : rule = '{ p "one" :- q 1 }. (*~ E0402 *)
$[typo].
