(* Callers of `len` that read its answers and are read by other calls of `len` (formerly a component of
   the moded `len` and its demand relation): the prelude's `len` measures the lists that are facts, so
   `pick`, `long` and `sized` are in later components. `sized` builds terms over the answers of `len`. *)
e : list int -> rel.
e (cons 1 nil). e (cons 2 (cons 3 nil)). e (cons 1 (cons 2 (cons 3 nil))).
pick : list int -> rel.
pick L :- e L, len L N, N < 3.
long : int -> rel.
long N :- pick L, len L N.
%output long.

sized : option int -> rel.
sized (some N) :- e L, len L N.
both : int -> int -> rel.
both N M :- sized (some N), e L, len L M, M > 2.
%output both.
