(* Comparisons are structural: they do not depend on which values were built. Here `red` and
   `cons red nil` are data terms that are only built by the comparisons themselves and by the demand of
   the query `?- d red.`, which must not change the answers of `other`, `same` and `notlist`. *)
color : type. red : color. blue : color.
p : color -> rel.
p blue.

other : color -> rel.
other X :- p X, X <> red.
%output other.

same : rel.
same :- p X, X = red.
%output same.

lists : list color -> rel.
lists (cons blue nil).
notlist : list color -> rel.
notlist L :- lists L, L <> cons red nil.
%output notlist.

d : (a : color) -> rel.
%mode d +a.
d X :- p X.
?- d red.
?- d blue.
