%use "std/eq" (tt).
%use "std/semantics".

city : type. berlin, paris, rome : city.
trip = {
  hop : city -> city -> rel.
  hop berlin paris.
  hop paris rome.
  path : city -> city -> rel.
  path X Y :- hop X Y.
  path X Z :- hop X Y, path Y Z.
}.

(* two rounds are not enough: `holds 2 …` is false, and `tt` is no
   proof of the empty type *)
viaParis : trip.path berlin rome = decide 2 tt.
%opaque viaParis.
