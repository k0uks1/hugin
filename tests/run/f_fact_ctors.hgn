(* Constructors and structs are fact constructors: their facts can be read as a relation, also for every
   instance of a family. `--all-relations` lists the facts of every constructor (`leaf` too). *)
tree A : type.
leaf : A -> tree A.
node : tree A -> tree A -> tree A.
seen : type = { at : int, what : string }.

grow : tree int -> rel.
grow (node (leaf 1) (leaf 2)).
lefts : tree int -> rel.
lefts L :- node L _.

seen 1 "a".
seen { at = 2, what = "b" }.
whats : string -> rel.
whats W :- seen { at = _, what = W }.
