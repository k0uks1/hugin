(* Values built as inputs of moded calls are probes: interned, so a moded relation can inspect them
   structurally, but not facts, so relations that read the constructor see only asserted values. %mode
   never adds facts to relations other than the moded relation and its demand relations. *)
shape : type.
circle : shape.
square : int -> shape.

area : (s : shape) -> (a : int) -> rel.
%mode area +s -a.
area circle 3.
area (square N) A :- A = N * N.

(* the demand of `area` builds `square 4` as a probe *)
q : int -> rel.
q A :- area (square 4) A.
%output q.

(* top-level atoms read facts only, so `square 4` is invisible here *)
seen : int -> rel.
seen N :- square N.
%output seen.

counted : int -> rel.
counted C :- C = count { N | square N }.
%output counted.
