(* Section 13.1: a library of graph operations *)
graph : mod = { node : type, edge : node -> node -> rel }.

tc (g : graph) = {
  path : g.node -> g.node -> rel.
  @p1 path X Y :- g.edge X Y.
  @p2 path X Z :- g.edge X Y, path Y Z.
}.

bounded (g : graph) (limit : int) = {
  hop : g.node -> g.node -> int -> rel.
  %terminates N (hop _ _ N).
  @h1 hop X Y 1 :- g.edge X Y.
  @h2 hop X Z M :- hop X Y N, g.edge Y Z, N < limit, M = N + 1.
}.

city : type.
berlin : city.
paris : city.
rome : city.
road : city -> city -> rel.
%input road.

road berlin paris.
road paris rome.
road rome berlin.

roads = tc { node = city, edge = road }.
short = bounded { node = city, edge = road } 5.

from_berlin : city -> rel.
@q from_berlin C :- roads.path berlin C.
%output from_berlin.
%output short.hop.
