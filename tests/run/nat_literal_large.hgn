(* A large nat literal (issue #131, batch 0): the numeral `suc (… zero)` is a nested application, and
   checking it for object code walks it once (it used to evaluate every argument again: quadratic). *)
nat : Type.
zero : nat.
suc : nat -> nat.

toInt : nat -> int.
toInt zero = 0.
toInt (suc N) = toInt N + 1.

big : nat = 500.

size : int -> rel.
size (toInt big).
%output size.
