(* Shared data declarations (issue #80; reference: meta/families, shared data): one declaration is a meta
   inductive family and an object family. A meta value of a shared type used as object code is lifted
   (`T.lift`, inserted by stage inference), and reified as `term` data at a hole of a quote (`T.reify`).
   Nested types (`list (tree A)`), mutually recursive types (`stmt`, `cond`), floats and strings, and
   compile-time lists of object code (`list (⇑int)`) are covered. *)
%use "std/reflect".

tree A : data.
leaf : A -> tree A.
node : (label : string) -> (kids : list (tree A)) -> tree A.

stmt : data.
skip : stmt.
when : cond -> stmt -> stmt.
cond : data.
always : cond.
nested : list stmt -> cond.

(* meta functions over the meta side *)
size : tree A -> int.
size (leaf X) = 1.
size (node L Ks) = sizes Ks + 1.
sizes : list (tree A) -> int.
sizes [] = 0.
sizes (K :: Ks) = size K + sizes Ks.

mk : int -> tree float.
mk N = node "root" [leaf 1.5, node "inner" [leaf 2.5], leaf 0.5].

t : tree float = mk 3.
prog : stmt = when (nested [skip, when always skip]) skip.

(* lifted into rule heads: the facts and all their subfacts *)
trees : tree float -> rel.
trees t.
progs : stmt -> rel.
progs prog.
counted : int -> rel.
counted (size t).

(* the object side: rules over the object constructors, list syntax at the object level *)
labelled : (l : string) -> rel.
labelled L :- trees T, T = node L _.
inner : (k : tree float) -> rel.
inner K :- trees (node _ (K :: _)).
pair : list int -> rel.
pair [1, 2].
firsts : (x : int) -> rel.
firsts X :- pair (X :: _).

(* explicit derived functions, and the rule Lift at an explicit splice *)
explicit : list (option int) -> rel.
explicit $(list.lift (option.lift ([y : int] y)) [some 1, none]).
spliced : option string -> rel.
spliced $(some "s").

(* a compile-time list of object code (the rule Code of the lifting judgement) *)
both : ⇑int -> ⇑int -> list (⇑int).
both X Y = [X, Y].
src : int -> rel.
src 7. src 8.
codes : list int -> rel.
codes (both X Y) :- src X, src Y, X < Y.

(* reified at holes of quotes: `reflect (reify v)` is the code `lift v` *)
reflected : tree float -> rel.
$'( reflected $t. ).
same_tree : int -> rel.
same_tree 1 :- trees T, reflected T.
named : rule = '( labelled $"quoted" ).
$[named].
terms : term = list.reify tint [3, 4].
listed : list int -> rel.
$'( listed $terms. ).

?- inner K.
?- labelled L.
?- firsts X.
?- explicit L.
?- spliced S.
?- codes L.
?- same_tree N.
?- counted N.
?- progs P.
?- listed L.
%output when.
