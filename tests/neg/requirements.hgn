(* Signature requirements (Section 4.4) and negation over parameters (Section 11). *)
g : Type = { node : type, edge : node -> node -> rel, %complete edge }.
iso (x : g) = {
  lonely : x.node -> rel.
  lonely N :- x.edge N _, not x.edge _ N.
}.
v : type.
e : v -> v -> rel.
%open e.
a = iso { node = v, edge = e }.
