{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hugin",
  "scopeName": "source.hugin",
  "fileTypes": ["hgn", "facts"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#directive" },
    { "include": "#rule-name" },
    { "include": "#declaration" },
    { "include": "#meta" },
    { "include": "#keyword" },
    { "include": "#variable" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.hugin",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.hugin" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.hugin" } },
      "patterns": [{ "include": "#comment" }]
    },
    "string": {
      "name": "string.quoted.double.hugin",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.hugin" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.hugin" } },
      "patterns": [
        { "name": "constant.character.escape.unicode.hugin", "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}" },
        { "name": "constant.character.escape.hugin", "match": "\\\\[\"\\\\nt]" },
        { "name": "invalid.illegal.escape.hugin", "match": "\\\\." }
      ]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.float.hugin", "match": "(?<![\\w'])\\d+\\.\\d+(?:[eE][+-]?\\d+)?" },
        { "name": "constant.numeric.integer.hugin", "match": "(?<![\\w'])\\d+(?![\\w'])" }
      ]
    },
    "directive": {
      "comment": "%input, %output, %import, ... (a directive name is a lowercase identifier)",
      "name": "keyword.control.directive.hugin",
      "match": "%[a-z][A-Za-z0-9_']*"
    },
    "rule-name": {
      "name": "entity.name.label.rule.hugin",
      "match": "@[a-z][A-Za-z0-9_']*"
    },
    "declaration": {
      "comment": "the head of an item, which a declaration declares and a clause, fact or rule defines: its first name in column 0 or after the period of an item on the same line (`expr : type. typ : type.`); and an indented `name : ...` or `name ... =` (a member of a module body)",
      "patterns": [
        {
          "match": "(?:^|(?<=\\.\\s))\\s*(?!(?:where|not|as|with|type|rel|prop|data|count|sum|min|max)(?![\\w']))([a-z][A-Za-z0-9_']*)(?![\\w']|\\.[a-z])",
          "captures": { "1": { "name": "entity.name.function.declaration.hugin" } }
        },
        {
          "match": "^\\s+([a-z][A-Za-z0-9_']*)(?=\\s*(?::(?!-)|=))",
          "captures": { "1": { "name": "entity.name.function.declaration.hugin" } }
        }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "storage.type.hugin", "match": "(?<![\\w'])(?:type|rel|prop)(?![\\w'])" },
        { "name": "storage.type.meta.hugin", "match": "(?<![\\w'])(?:Type[₀-₉]*|data)(?![\\w'])" },
        { "name": "support.type.base.hugin", "match": "(?<![\\w'])(?:int|float|string)(?![\\w'])" },
        { "name": "keyword.other.where.hugin", "match": "(?<![\\w'])where(?![\\w'])" },
        { "name": "keyword.operator.word.hugin", "match": "(?<![\\w'])(?:not|as|with)(?![\\w'])" },
        { "name": "support.function.aggregate.hugin", "match": "(?<![\\w'])(?:count|sum|min|max)(?![\\w'])" }
      ]
    },
    "meta": {
      "comment": "the meta level's syntax: typed holes `?` and `?name` (not `?-`), quote holes `$..xs` and splices `$x`, the lift, `::`, and reflection quotes `'( … )` (parentheses nest inside)",
      "patterns": [
        { "name": "keyword.other.hole.hugin", "match": "\\?(?!-)[A-Za-z0-9_']*" },
        { "name": "keyword.operator.splice.sequence.hugin", "match": "\\$\\.\\." },
        { "name": "keyword.operator.splice.hugin", "match": "\\$" },
        { "name": "keyword.operator.lift.hugin", "match": "⇑" },
        { "name": "keyword.operator.cons.hugin", "match": "::" },
        {
          "name": "meta.quote.hugin",
          "begin": "(?<![\\w'])'\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "punctuation.section.quote.begin.hugin" } },
          "endCaptures": { "0": { "name": "punctuation.section.quote.end.hugin" } },
          "patterns": [{ "include": "#parens" }, { "include": "$self" }]
        }
      ]
    },
    "parens": {
      "comment": "parentheses inside a quote, so that the quote ends at its own `)`",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [{ "include": "#parens" }, { "include": "$self" }]
    },
    "variable": {
      "patterns": [
        { "name": "variable.language.wildcard.hugin", "match": "(?<![\\w'])_(?![\\w'])" },
        { "name": "variable.other.hugin", "match": "(?<![\\w'])[A-Z_][A-Za-z0-9_']*" }
      ]
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.rule.hugin", "match": ":-|\\?-" },
        { "name": "keyword.operator.type.hugin", "match": "->|<:" },
        { "name": "keyword.operator.rest.hugin", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.hugin", "match": "<>|<=|>=|<|>|=" },
        { "name": "keyword.operator.arithmetic.hugin", "match": "[-+*/^]" },
        { "name": "keyword.operator.alternative.hugin", "match": "\\|" },
        { "name": "keyword.operator.colon.hugin", "match": ":" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.accessor.hugin", "match": "(?<=[A-Za-z0-9_'])\\.(?=[a-z])" },
        { "name": "punctuation.terminator.hugin", "match": "\\." },
        { "name": "punctuation.separator.hugin", "match": "[,;]" }
      ]
    }
  }
}
