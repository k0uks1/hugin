(* ---------------- after elaborate ---------------- *)
pick : {A : Type} -> A -> A -> A.
  pick X _ = X.
ident : {A : Type} -> A -> A.
  ident X = X.
a : nat = pick {nat} 3 0.
b : nat = pick {nat} 0 3.
c : int = pick {int} 3 4.
d : int = ident {int} 5.
r : (n : int) -> rel.
r 3.
r 0.
r 3.
r 5.
?- r N.
?- r N.
N = 0.
N = 3.
N = 5.
