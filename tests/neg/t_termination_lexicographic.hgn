(* issue #2: Ackermann's function with the components of the lexicographic measure swapped *)
ack : (m : int) -> (n : int) -> (r : int) -> rel.
%mode ack +m +n -r.
%terminates (n, m) ack.
ack 0 N R :- R = N + 1.
ack M 0 R :- M > 0, ack (M - 1) 1 R. (*~ E0604 *)
ack M N R :- M > 0, N > 0, ack M (N - 1) R1, ack (M - 1) R1 R.
?- ack 2 3 R.
