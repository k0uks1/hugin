(* #186 P9b, P9g: an applied relation that no program owns is not coerced to a judgment and stays E0960,
   whose help names the turnstile: a variable's relation (every program over `G` reads it), a relation of
   the file inside a module body (the body's program does not declare it), and a relation of the body
   under an explicit lift. *)
%use "std/graph".
%use "std/semantics".

city : type. berlin, paris : city.
road : city -> city -> rel.
%input road.

edgeIn : {x y : G.node} -> G.edge x y -> tc G ⊢ G.edge x y. (*~ E0960 *)
edgeIn E = E.

tc3 (g : graph) = { (*~ W0003 *)
  path : g.node -> g.node -> rel.
  path X Y :- g.edge X Y.
  file : {x y : city} -> road x y -> Type. (*~ E0960 *)
  file _ = Type.
  lifted : {x y : g.node} -> ⇑(path x y) -> Type. (*~ E0960 *)
  lifted _ = Type.
}.
