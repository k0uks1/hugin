(* Reachability at both stages (issues #52, #80). The graph is one value, a list of edges of the shared
   type `edge`, used at compile time by a meta function and at run time as facts: stating it as a fact
   (`known graph.`, `list.lift` is inserted) builds its subfacts, among them the edges `e 1 2`, …, which
   the relation `road` reads. The two definitions of reachability stay different, on purpose: at the
   object level it is the least fixed point of two rules (the prelude's functor `tc`); at the meta level
   a function must be structurally recursive, so the closure is computed by iterating a step a bounded
   number of times (the number of edges suffices). Before #80 the graph was written twice (as facts of
   `road` and as a list of a meta type `medge`). *)

edge : data.
e : (from : int) -> (to : int) -> edge.

graph : list edge = [e 1 2, e 2 3, e 3 1, e 4 5].

(* The object definition. *)
known : list edge -> rel.
known graph.
road : int -> int -> rel.
road X Y :- e X Y.
roads = tc { node = int, edge = road }.

(* The meta definition over the same graph. *)
nat : Type.  zero : nat.  suc : nat -> nat.

size : list edge -> nat.
size [] = zero.
size (E :: Es) = suc (size Es).

mem : int -> list int -> bool.
mem X [] = false.
mem X (Y :: Ys) = bor (same X Y) (mem X Ys).

addNew : int -> list int -> list int.
addNew X Ys = addIf (mem X Ys) X Ys.

addIf : bool -> int -> list int -> list int.
addIf true X Ys = Ys.
addIf false X Ys = X :: Ys.

(* One step: add the target of every edge whose source is reached. *)
step : list edge -> list int -> list int.
step [] R = R.
step (e A B :: Es) R = step Es (stepEdge (mem A R) B R).

stepEdge : bool -> int -> list int -> list int.
stepEdge true B R = addNew B R.
stepEdge false B R = R.

iter : nat -> list edge -> list int -> list int.
iter zero G R = R.
iter (suc N) G R = iter N G (step G R).

(* the nodes reachable from X by a path of at least one edge *)
reach : list edge -> int -> list int.
reach G X = iter (size G) G (step G [X]).

static_reach : int -> rel.
static_reach (slen (reach graph 1)).
dynamic_reach : int -> rel.
dynamic_reach N :- N = count { Y | roads.path 1 Y }.
%output static_reach.
%output dynamic_reach.

slen : list A -> int.
slen [] = 0.
slen (X :: Xs) = slen Xs + 1.
