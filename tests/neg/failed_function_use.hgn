(* A function whose clauses fail (here an unsolved hole) is left without a case tree, so a use never
   evaluates a tree over the undone metas of the failure; like the uses of any failed item, the use is
   left out without a further error (issue #121). *)
%use "std/reflect".
knows : (int) -> rel.
twice : ((A)) -> item.
twice = ( _ ). (*~ E0903 *)
%twice knows.
