(* #186 P8b: a certified run of a positive program (reference: std/certify). With `--certify`, the
   checker of `std/certify` builds a derivation of every fact of the run and checks that the facts are
   closed under the rules, so they are the least model of the program from the input facts. Below, the
   same checker on certificates written by hand: one is accepted, one names a fact that its premises do
   not derive, and one leaves out a fact that the rules derive. *)
%use "std/eq" (eq, refl).
%use "std/semantics" (gatom, atom, own, v).
%use "std/certify".

city : type. berlin, paris, rome, oslo : city.
road : city -> city -> int -> rel.
%input road.
reach : city -> city -> rel.
reach X Y :- road X Y _.
reach X Z :- reach X Y, road Y Z _.
long : city -> city -> rel.
long X Y :- road X Y D, D >= 1000.
%output reach. %output long.

(* the transitive closure as a reified program: `path` is `own 0`, `edge` the input relation `own 1` *)
path1 : urule = urul 0 1 [city, city] [uat (own 0) [uvar 0, uvar 1]] [upos (uat (own 1) [uvar 0, uvar 1])].
path2 : urule = urul 0 2 [city, city, city] [uat (own 0) [uvar 0, uvar 2]]
  [upos (uat (own 1) [uvar 0, uvar 1]), upos (uat (own 0) [uvar 1, uvar 2])].
tc : uprogram = uprog ["path", "edge"] [path1, path2] [1] [[1], [0]].
e : ⇑city -> ⇑city -> gatom = [x] [y] atom (own 1) [v x, v y].
p : ⇑city -> ⇑city -> gatom = [x] [y] atom (own 0) [v x, v y].
edges : list gatom = [e (<berlin>) (<paris>), e (<paris>) (<rome>)].

(* the premises are positions among the facts before: the input facts first, the last derived fact at 0 *)
accepts : eq (certifyPositive tc edges [cf (p (<berlin>) (<paris>)) [0], cf (p (<paris>) (<rome>)) [2],
                                        cf (p (<berlin>) (<rome>)) [2, 0]]) (accepted 5) = refl.
notDerived : eq (certifyPositive tc edges [cf (p (<berlin>) (<paris>)) [0], cf (p (<rome>) (<paris>)) [2]])
                (rejected (badFact (p (<rome>) (<paris>)))) = refl.
notClosedRun : eq (certifyPositive tc edges [cf (p (<berlin>) (<paris>)) [0], cf (p (<paris>) (<rome>)) [2]])
                  (rejected (notClosed 0)) = refl.
%opaque accepts notDerived notClosedRun.
