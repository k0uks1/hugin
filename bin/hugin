#!/usr/bin/env bash
# Launcher for the Hugin reference implementation: runs the script staged by sbt-native-packager,
# staging it first if needed (set HUGIN_REBUILD=1 to re-stage after changing the sources).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STAGED="$ROOT/target/universal/stage/bin/hugin"
if [[ ! -x "$STAGED" || "${HUGIN_REBUILD:-0}" == "1" ]]; then
  # on stderr: stdout may be a protocol channel (`hugin lsp`)
  (cd "$ROOT" && sbt -batch -error stage) >&2
fi
exec "$STAGED" "$@"
