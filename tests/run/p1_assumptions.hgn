(* `--print-assumptions f` lists the postulates `f` depends on, transitively, through types, values
   and clauses (issue #186, P1; Lean's `#print axioms`). *)
eqn : nat -> nat -> Type.
same : eqn N N.
plus : nat -> nat -> nat.
plus 0 N = N.
plus (M + 1) N = plus M N + 1.
plusZero : (n : nat) -> eqn (plus n 0) n = %postulate.
zeroPlus : (n : nat) -> eqn (plus 0 n) n = %postulate.
unused : eqn 1 2 = %postulate.
(* through a value *)
lemma : eqn (plus 2 0) 2 = plusZero 2.
(* through the clauses of a function, and another definition *)
both : nat -> nat.
both 0 = 0.
both (N + 1) = use (zeroPlus N) N.
use : eqn M N -> nat -> nat.
use _ K = K.
(* through a type *)
hidden : nat = %postulate.
needs : eqn hidden 0 -> nat.
needs _ = 0.
proved : eqn (plus 1 1) 2 = same.
result : int -> rel.
result 1.
