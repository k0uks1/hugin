(* Reflection (reference: reflection): the core step of %demand for one relation, written with quoted
   patterns. `guard` adds the demand relation to the rules of `typed` and `propagate` passes demand to
   the recursive calls; the rules are reflected back into the program by the item `$guardAll rules.`
   (`typed_check` stands for `typed.check`, which Phase C3 names). The generated rules are shown with
   `--print-after stage`, then the answers. *)
%use "std/reflect".
expr : type.
ctx : type.
typ : type.
ref : string -> expr.
app : expr -> expr -> expr.
emp : ctx.
bind : string -> typ -> ctx -> ctx.
base : string -> typ.
arr : typ -> typ -> typ.

typed : expr -> ctx -> typ -> rel.
typed_check : expr -> ctx -> rel.
lookup : ctx -> string -> typ -> rel.

guard : rule -> list rule.
guard '( typed $E $G $T :- $..Body ) =
  '( typed $E $G $T :- typed_check $E $G, $..Body )
  :: propagate '( typed_check $E $G ) Body.
guard R = [R].                                   (* all other rules unchanged; coverage needs it *)

propagate : formula -> list formula -> list rule.
propagate Pre [] = [].
propagate Pre ('( typed $E2 $G2 $_ ) :: Rest) = '( typed_check $E2 $G2 :- $Pre ) :: propagate Pre Rest.
propagate Pre (F :: Rest) = propagate '( $Pre, $F ) Rest.

guardAll : list rule -> list rule.
guardAll [] = [].
guardAll (R :: Rs) = append (guard R) (guardAll Rs).

rules : list rule = '(
  typed (ref X) G T :- lookup G X T.
  typed (app F A) G T :- typed F G (arr S T), typed A G S.
).

$guardAll rules.

%demand lookup + + -.
lookup (bind X T _) X T.
lookup (bind Y _ G) X T :- lookup G X T, X <> Y.

typed_check (app (ref "f") (ref "x")) (bind "f" (arr (base "i") (base "b")) (bind "x" (base "i") emp)).

?- typed E _ T.
