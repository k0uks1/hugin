(* std/semantics: the meaning of Datalog programs in the meta level (reference: std/semantics). A program
   is data: its rules over typed variables, as de Bruijn indices; the facts are atoms of values, which are
   closed object code; and `derives p d a` is the inductive family of the derivations of the fact `a` by
   the program `p` from the input facts `d`. `derives` is the positive fragment: atoms and comparisons in
   bodies, the object level's 64-bit arithmetic. Bodies may also have negations and aggregates, which
   `derives` does not read; `std/strata` reads them, one stratum at a time. The judgment is a library
   family, not a core rule: its consistency is that of inductive families (the proofs note, chapter 8). *)
%use "std/reflect" (bool, true, false, if, list, nil, cons, option, none, some, sym, arith_op, oadd, osub, omul,
  odiv, ocat, cmp_op, ceq, cne, clt, cle, cgt, cge, agg_op).
%use "std/nat" (nat, equal).
%use "std/int" (iequal, iless, ileq, fits64).
%use "std/eq" (eq, refl, cong, subst, empty, emptyElim, unit, tt, dec, yes, no, decEq).
%use "std/decide" (so, decider).
%use "std/list" (map, concat, any).

(* Values: closed object code of any object type. A literal is a value (`v ⟨3⟩`), and so is the identity
   of a fact, its object term (`v ⟨edge berlin paris⟩`): two values are equal exactly if they are the same
   code, as two facts are the same fact exactly if they have the same constant and arguments *)
value : Type.
v : {t : ⇑type} -> ⇑t -> value.

(* Relations, relative to a program: its own relation number `i`, the relation of a functor parameter by
   the field of its signature, or a relation outside the program *)
rref : Type.
own : nat -> rref.
arg : string -> rref.
ext : sym -> rref.

(* Facts: a relation with its arguments; a database is a set of facts, as a predicate *)
gatom : Type.
atom : rref -> list value -> gatom.
db : Type = gatom -> Type.

(* `member x xs`: `x` is an element of `xs`, at the position the proof counts *)
member : {A : Type} -> A -> list A -> Type.
here : {A : Type} -> {x : A} -> {xs : list A} -> member x (x :: xs).
there : {A : Type} -> {x y : A} -> {xs : list A} -> member x xs -> member x (y :: xs).

(* The values of a rule's variables, typed: `env [τ₁, …, τₙ]` holds code of the types `τ₁ … τₙ` *)
env : list ⇑type -> Type.
enil : env [].
econs : {t : ⇑type} -> {ts : list ⇑type} -> ⇑t -> env ts -> env (t :: ts).

(* The value of the variable at a position *)
valueAt : {ts : list ⇑type} -> {t : ⇑type} -> env ts -> member t ts -> ⇑t.
valueAt (econs X Xs) here = X.
valueAt (econs X Xs) (there I) = valueAt Xs I.

(* The values of an environment, untyped *)
values : {ts : list ⇑type} -> env ts -> list value.
values enil = [].
values (econs X Xs) = v X :: values Xs.

(* The object level's arithmetic (reference: object/arithmetic), computed on the meta integers of
   `std/int`: `none` where the object operation is undefined, outside 64 bits or by a division by zero.
   `intOf` is the meta integer of an object integer literal (a trusted primitive); a sum of two literals
   is the literal of the sum, if it fits *)
intOf : ⇑int -> int = %builtin intOf.

codeOf : int -> ⇑int = [n] n.

within64 : int -> option ⇑int.
within64 N = if (fits64 N) (some (codeOf N)) none.

add64 : ⇑int -> ⇑int -> option ⇑int = [a] [b] within64 (intOf a + intOf b).
sub64 : ⇑int -> ⇑int -> option ⇑int = [a] [b] within64 (intOf a - intOf b).
mul64 : ⇑int -> ⇑int -> option ⇑int = [a] [b] within64 (intOf a * intOf b).
div64 : ⇑int -> ⇑int -> option ⇑int = [a] [b] if (iequal (intOf b) 0) none (within64 (intOf a / intOf b)).
neg64 : ⇑int -> option ⇑int = [a] within64 (-(intOf a)).

(* An operation of `std/reflect` on integers; concatenation is not one *)
arith64 : arith_op -> ⇑int -> ⇑int -> option ⇑int.
arith64 oadd A B = add64 A B.
arith64 osub A B = sub64 A B.
arith64 omul A B = mul64 A B.
arith64 odiv A B = div64 A B.
arith64 ocat A B = none.

(* The terms of a rule, over its variables `ts`: `cterm ts τ` is a term of the object type `τ`, and
   `cterms ts [τ₁, …, τₙ]` a list of terms of the types `τ₁ … τₙ`. A variable is its position; a constant
   or literal is its code; `capp f ts` builds object code from the values of the terms `ts` with the meta
   function `f`, as a constructor term `circle (X + 1)` does (`capp ([e] ⟨circle $(…)⟩) …`) *)
cterm : list ⇑type -> ⇑type -> Type.
cterms : list ⇑type -> list ⇑type -> Type.
cv : {ts : list ⇑type} -> {t : ⇑type} -> member t ts -> cterm ts t.
cc : {ts : list ⇑type} -> {t : ⇑type} -> ⇑t -> cterm ts t.
capp : {ts ss : list ⇑type} -> {t : ⇑type} -> (env ss -> ⇑t) -> cterms ts ss -> cterm ts t.
carith : {ts : list ⇑type} -> arith_op -> cterm ts int -> cterm ts int -> cterm ts int.
cneg : {ts : list ⇑type} -> cterm ts int -> cterm ts int.
tnil : {ts : list ⇑type} -> cterms ts [].
tcons : {ts ss : list ⇑type} -> {t : ⇑type} -> cterm ts t -> cterms ts ss -> cterms ts (t :: ss).

(* An atom of a rule: a relation with its argument terms *)
catom : list ⇑type -> Type.
cat : {ts ss : list ⇑type} -> rref -> cterms ts ss -> catom ts.

(* A literal of a rule's body: an atom, a comparison of two terms of the same type, a negated atom, or an
   aggregate. A negation and an aggregate have local variables `us`, before the rule's: `cnot us a` holds
   if no values of `us` make `a` a fact, and `cagg us o x t bs` if `x` is the aggregate `o` of the term `t`
   over the values of `us` for which the body `bs` holds (reference: object/aggregates) *)
cbody : list ⇑type -> Type.
cpos : {ts : list ⇑type} -> catom ts -> cbody ts.
ccmp : {ts : list ⇑type} -> {t : ⇑type} -> cmp_op -> cterm ts t -> cterm ts t -> cbody ts.
cnot : {ts : list ⇑type} -> (us : list ⇑type) -> catom (append us ts) -> cbody ts.
cagg : {ts : list ⇑type} -> (us : list ⇑type) -> agg_op -> cterm ts int -> cterm (append us ts) int ->
       list (cbody (append us ts)) -> cbody ts.

(* A rule: its head relation and its position among the rules of that relation (for its name `r.k`), an
   optional label, the types of its variables, its head atoms (the head and its nested facts) and its
   body. A program: the names of its own relations, its rules, its input relations and its strata *)
crule : Type = { head : nat, index : nat, label : option string, vars : list ⇑type,
                 heads : list (catom vars), body : list (cbody vars) }.
program : Type = { relations : list string, rules : list crule, input : rref -> bool, strata : list (list nat) }.

(* The input test of the programs that `programOf` builds (reference: std/quote): the relations of the
   module's parameters and outside it, and its own relations `Is` without rules (the extensional relations) *)
inputOf : list nat -> rref -> bool.
inputOf Is (own I) = any ([j] equal I j) Is.
inputOf Is (arg L) = true.
inputOf Is (ext S) = true.

(* Instantiating terms and atoms with the values of the variables: `none` where arithmetic is undefined *)
optMap : {A B : Type} -> (A -> B) -> option A -> option B.
optMap F (some X) = some (F X).
optMap F none = none.

optArith : arith_op -> option ⇑int -> option ⇑int -> option ⇑int.
optArith O (some A) (some B) = arith64 O A B.
optArith O X Y = none.

optNeg : option ⇑int -> option ⇑int.
optNeg (some A) = neg64 A.
optNeg none = none.

optCons : {t : ⇑type} -> {ts : list ⇑type} -> option ⇑t -> option (env ts) -> option (env (t :: ts)).
optCons (some X) (some Xs) = some (econs X Xs).
optCons X Y = none.

instTerm : {ts : list ⇑type} -> {t : ⇑type} -> env ts -> cterm ts t -> option ⇑t.
instTerms : {ts ss : list ⇑type} -> env ts -> cterms ts ss -> option (env ss).
instTerm Xs (cv I) = some (valueAt Xs I).
instTerm Xs (cc C) = some C.
instTerm Xs (capp F As) = optMap F (instTerms Xs As).
instTerm Xs (carith O A B) = optArith O (instTerm Xs A) (instTerm Xs B).
instTerm Xs (cneg A) = optNeg (instTerm Xs A).
instTerms Xs tnil = some enil.
instTerms Xs (tcons T Ts) = optCons (instTerm Xs T) (instTerms Xs Ts).

(* An instantiated atom: its relation, and its arguments, `none` if arithmetic in them is undefined. The
   relation is outside the option, so that an atom of another relation is told apart even while the
   arithmetic in its arguments is not computed, as with variables in a proof *)
patom : Type.
pat : rref -> option (list value) -> patom.

instAtom : {ts : list ⇑type} -> env ts -> catom ts -> patom.
instAtom Xs (cat R As) = pat R (optMap values (instTerms Xs As)).

(* When a comparison holds of two instantiated terms: equality and disequality of values of any type (the
   same code), the order of integers *)
holdsCmp : {t : ⇑type} -> cmp_op -> option ⇑t -> option ⇑t -> Type.
cmpEq : {t : ⇑type} -> {x : ⇑t} -> holdsCmp ceq (some x) (some x).
cmpNe : {t : ⇑type} -> {x y : ⇑t} -> (eq x y -> empty) -> holdsCmp cne (some x) (some y).
cmpLt : {x y : ⇑int} -> so (iless (intOf x) (intOf y)) -> holdsCmp clt (some x) (some y).
cmpLe : {x y : ⇑int} -> so (ileq (intOf x) (intOf y)) -> holdsCmp cle (some x) (some y).
cmpGt : {x y : ⇑int} -> so (iless (intOf y) (intOf x)) -> holdsCmp cgt (some x) (some y).
cmpGe : {x y : ⇑int} -> so (ileq (intOf y) (intOf x)) -> holdsCmp cge (some x) (some y).

(* Derivations: `derives p d a` is a proof that the program `p` derives the fact `a` from the input facts
   `d`, and `premises p d xs bs` that the body literals `bs` hold for the values `xs` of a rule's
   variables. The two families are mutually inductive. A fact of an input relation is derived if it is
   in `d` (`given`); a rule fires for values of its variables for which its body holds, and derives each
   of its instantiated heads (`fire`). The goal atom of `fire` is made of variables and the head is a
   membership, so that matching on `fire` with a known rule is decided by evaluating `instAtom` (the
   proofs note, 7.2). *)
derives : program -> db -> gatom -> Type.
premises : program -> db -> {ts : list ⇑type} -> env ts -> list (cbody ts) -> Type.
given : {p : program} -> {d : db} -> {r : rref} -> {vs : list value} ->
        so (p.input r) -> d (atom r vs) -> derives p d (atom r vs).
fire : {p : program} -> {d : db} -> {r : rref} -> {vs : list value} -> {c : crule} -> {xs : env c.vars} ->
       member c p.rules -> premises p d xs c.body -> member (pat r (some vs)) (map (instAtom xs) c.heads) ->
       derives p d (atom r vs).
pnil : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> premises p d xs [].
ppos : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> {b : catom ts} -> {r : rref} ->
       {vs : list value} -> {bs : list (cbody ts)} ->
       eq (instAtom xs b) (pat r (some vs)) -> derives p d (atom r vs) -> premises p d xs bs ->
       premises p d xs (cpos b :: bs).
pcmp : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> {t : ⇑type} -> {o : cmp_op} ->
       {l r : cterm ts t} -> {bs : list (cbody ts)} ->
       holdsCmp o (instTerm xs l) (instTerm xs r) -> premises p d xs bs -> premises p d xs (ccmp o l r :: bs).

(* Monotonicity: a program derives more facts from more input facts, and a program with more rules (and
   more input relations) derives more facts *)
included : db -> db -> Type = [d] [e] (a : gatom) -> d a -> e a.

monotone : {p : program} -> {d e : db} -> included d e -> {a : gatom} -> derives p d a -> derives p e a.
monotonePremises : {p : program} -> {d e : db} -> included d e -> {ts : list ⇑type} -> {xs : env ts} ->
                   {bs : list (cbody ts)} -> premises p d xs bs -> premises p e xs bs.
monotone I (given T F) = given T (I _ F).
monotone I (fire M Ps H) = fire M (monotonePremises I Ps) H.
monotonePremises I pnil = pnil.
monotonePremises I (ppos E D Ps) = ppos E (monotone I D) (monotonePremises I Ps).
monotonePremises I (pcmp C Ps) = pcmp C (monotonePremises I Ps).

extends : program -> program -> Type = [p] [q] {
  rules : (c : crule) -> member c p.rules -> member c q.rules,
  inputs : (r : rref) -> so (p.input r) -> so (q.input r) }.

grow : {p q : program} -> {d : db} -> extends p q -> {a : gatom} -> derives p d a -> derives q d a.
growPremises : {p q : program} -> {d : db} -> extends p q -> {ts : list ⇑type} -> {xs : env ts} ->
               {bs : list (cbody ts)} -> premises p d xs bs -> premises q d xs bs.
grow X (given {r := R} T F) = given (X.inputs R T) F.
grow X (fire {c := C} M Ps H) = fire (X.rules C M) (growPremises X Ps) H.
growPremises X pnil = pnil.
growPremises X (ppos E D Ps) = ppos E (grow X D) (growPremises X Ps).
growPremises X (pcmp C Ps) = pcmp C (growPremises X Ps).

(* Models: a database that contains the input facts and is closed under the rules. The facts that
   `derives p d` holds of form the least model (Tantow et al.'s `modelAndProofTreeSemanticsEquivalent`) *)
both : Type -> Type -> Type = [a] [b] { fst : a, snd : b }.

atomIn : db -> patom -> Type.
atomIn M (pat R (some Vs)) = M (atom R Vs).
atomIn M (pat R none) = empty.

holdsIn : db -> {ts : list ⇑type} -> env ts -> list (cbody ts) -> Type.
holdsIn M Xs [] = unit.
holdsIn M Xs (cpos B :: Bs) = both (atomIn M (instAtom Xs B)) (holdsIn M Xs Bs).
holdsIn M Xs (ccmp O L R :: Bs) = both (holdsCmp O (instTerm Xs L) (instTerm Xs R)) (holdsIn M Xs Bs).
holdsIn M Xs (cnot Us B :: Bs) = empty.
holdsIn M Xs (cagg Us O R T Cs :: Bs) = empty.

model : program -> db -> db -> Type.
isModel : {p : program} -> {d m : db} ->
          ((r : rref) -> (vs : list value) -> so (p.input r) -> d (atom r vs) -> m (atom r vs)) ->
          ((c : crule) -> member c p.rules -> (xs : env c.vars) -> holdsIn m xs c.body -> (r : rref) ->
           (vs : list value) -> member (pat r (some vs)) (map (instAtom xs) c.heads) -> m (atom r vs)) ->
          model p d m.

eqBack : {A : Type} -> {x y : A} -> eq x y -> eq y x.
eqBack refl = refl.

(* every model contains the derived facts *)
least : {p : program} -> {d m : db} -> model p d m -> {a : gatom} -> derives p d a -> m a.
leastPremises : {p : program} -> {d m : db} -> model p d m -> {ts : list ⇑type} -> {xs : env ts} ->
                {bs : list (cbody ts)} -> premises p d xs bs -> holdsIn m xs bs.
least (isModel In Ru) (given {r := R} {vs := Vs} T F) = In R Vs T F.
least {d := D} {m := Mo} (isModel In Ru) (fire {r := R} {vs := Vs} {c := C} {xs := Xs} I Ps H) =
  Ru C I Xs (leastPremises {d := D} {m := Mo} (isModel In Ru) Ps) R Vs H.
leastPremises M pnil = tt.
leastPremises {m := Mo} M (ppos E D Ps) = { fst = subst (atomIn Mo) (eqBack E) (least M D), snd = leastPremises M Ps }.
leastPremises M (pcmp C Ps) = { fst = C, snd = leastPremises M Ps }.

(* the derived facts are a model *)
pposFrom : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> {b : catom ts} ->
           {bs : list (cbody ts)} -> (q : patom) -> eq (instAtom xs b) q -> atomIn (derives p d) q ->
           premises p d xs bs -> premises p d xs (cpos b :: bs).
pposFrom (pat R (some Vs)) E D Ps = ppos E D Ps.
pposFrom (pat R none) E () Ps.

fromHolds : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> (bs : list (cbody ts)) ->
            holdsIn (derives p d) xs bs -> premises p d xs bs.
fromHolds [] H = pnil.
fromHolds {xs := Xs} (cpos B :: Bs) H = pposFrom {xs := Xs} {b := B} (instAtom Xs B) refl H.fst (fromHolds Bs H.snd).
fromHolds (ccmp O L R :: Bs) H = pcmp H.fst (fromHolds Bs H.snd).
fromHolds (cnot Us B :: Bs) H = emptyElim H.
fromHolds (cagg Us O R T Cs :: Bs) H = emptyElim H.

derivesModel : {p : program} -> {d : db} -> model p d (derives p d) =
  isModel ([r] [vs] [t] [f] given t f) ([c] [i] [xs] [h] [r] [vs] [m] fire {xs := xs} i (fromHolds c.body h) m).

(* the least model: a fact is derived exactly if it is in every model *)
leastModel : {p : program} -> {d : db} -> (a : gatom) ->
             { to : derives p d a -> (m : db) -> model p d m -> m a,
               from : ((m : db) -> model p d m -> m a) -> derives p d a }.
leastModel {p := P} {d := D} A = { to = [x] [m] [mm] least mm x, from = [f] f (derives P D) derivesModel }.

(* Proof by evaluation: `holds n p a` is `true` if `n` rounds of naive evaluation of `p`'s rules, from no
   input facts, derive `a`. The evaluation is certifying: each fact it finds carries its derivation, built
   with `fire` and checked by the type of `derives`, so its soundness is reading the derivation off. The
   valuations of a rule are found by matching its body atoms against the facts, unchecked; each is then
   checked, with proofs, by evaluating the rule's body. *)
fromDec : {A : Type} -> dec A -> option A.
fromDec (yes X) = some X.
fromDec (no F) = none.

isSome : {A : Type} -> option A -> bool.
isSome (some X) = true.
isSome none = false.

fromSome : {A : Type} -> (o : option A) -> so (isSome o) -> A.
fromSome (some X) T = X.
fromSome none ().

soIf : (b : bool) -> option (so b).
soIf true = some tt.
soIf false = none.

(* equations of relations, values and facts, decided; `same` decides atoms and closed object code *)
eqRref : (r s : rref) -> option (eq r s).
eqRref (own M) (own N) = optMap (cong own) (fromDec (decEq M N)).
eqRref (arg A) (arg B) = optMap (cong arg) (fromDec (decEq A B)).
eqRref (ext A) (ext B) = optMap (cong ext) (fromDec (decEq A B)).
eqRref R S = none.

eqValueAt : {s t : ⇑type} -> option (eq s t) -> (x : ⇑s) -> (y : ⇑t) -> option (eq (v x) (v y)).
eqValueAt (some refl) X Y = optMap (cong v) (fromDec (decEq X Y)).
eqValueAt none X Y = none.

eqValue : (a b : value) -> option (eq a b).
eqValue (v {t := S} X) (v {t := T} Y) = eqValueAt (fromDec (decEq S T)) X Y.

eqCons : {a b : value} -> {us ws : list value} -> option (eq a b) -> option (eq us ws) -> option (eq (a :: us) (b :: ws)).
eqCons (some refl) (some refl) = some refl.
eqCons X Y = none.

eqValues : (us ws : list value) -> option (eq us ws).
eqValues [] [] = some refl.
eqValues (A :: As) (B :: Bs) = eqCons (eqValue A B) (eqValues As Bs).
eqValues As Bs = none.

eqAtom2 : {r s : rref} -> {vs ws : list value} -> option (eq r s) -> option (eq vs ws) -> option (eq (atom r vs) (atom s ws)).
eqAtom2 (some refl) (some refl) = some refl.
eqAtom2 X Y = none.

eqGatom : (a b : gatom) -> option (eq a b).
eqGatom (atom R Vs) (atom S Ws) = eqAtom2 (eqRref R S) (eqValues Vs Ws).

(* facts with their derivations *)
dfact : program -> db -> Type = [p] [d] { fact : gatom, proof : derives p d fact }.

found : {p : program} -> {d : db} -> {a b : gatom} -> option (eq a b) -> derives p d a -> option (derives p d b) ->
        option (derives p d b).
found (some refl) D R = some D.
found none D R = R.

findFact : {p : program} -> {d : db} -> (a : gatom) -> list (dfact p d) -> option (derives p d a).
findFact A [] = none.
findFact A (F :: Fs) = found (eqGatom F.fact A) F.proof (findFact A Fs).

factsOf : {p : program} -> {d : db} -> list (dfact p d) -> list gatom.
factsOf [] = [].
factsOf (F :: Fs) = F.fact :: factsOf Fs.

(* candidate valuations: the variables bound so far, by matching body atoms against facts *)
penv : list ⇑type -> Type.
pend : penv [].
pvar : {t : ⇑type} -> {ts : list ⇑type} -> option ⇑t -> penv ts -> penv (t :: ts).

unbound : (ts : list ⇑type) -> penv ts.
unbound [] = pend.
unbound (T :: Ts) = pvar none (unbound Ts).

pget : {ts : list ⇑type} -> {t : ⇑type} -> penv ts -> member t ts -> option ⇑t.
pget (pvar X Xs) here = X.
pget (pvar X Xs) (there I) = pget Xs I.

pset : {ts : list ⇑type} -> {t : ⇑type} -> penv ts -> member t ts -> ⇑t -> penv ts.
pset (pvar X Xs) here Y = pvar (some Y) Xs.
pset (pvar X Xs) (there I) Y = pvar X (pset Xs I Y).

complete : {ts : list ⇑type} -> penv ts -> option (env ts).
complete pend = some enil.
complete (pvar X Xs) = optCons X (complete Xs).

castTo : {s t : ⇑type} -> option (eq s t) -> ⇑s -> option ⇑t.
castTo (some refl) X = some X.
castTo none X = none.

codeAs : (t : ⇑type) -> value -> option ⇑t.
codeAs T (v {t := S} X) = castTo (fromDec (decEq S T)) X.

keepIf : {A B : Type} -> option A -> B -> option B.
keepIf (some X) Y = some Y.
keepIf none Y = none.

pinst : {ts : list ⇑type} -> {t : ⇑type} -> penv ts -> cterm ts t -> option ⇑t.
pinsts : {ts ss : list ⇑type} -> penv ts -> cterms ts ss -> option (env ss).
pinst P (cv I) = pget P I.
pinst P (cc C) = some C.
pinst P (capp F As) = optMap F (pinsts P As).
pinst P (carith O A B) = optArith O (pinst P A) (pinst P B).
pinst P (cneg A) = optNeg (pinst P A).
pinsts P tnil = some enil.
pinsts P (tcons T Ts) = optCons (pinst P T) (pinsts P Ts).

matchCode : {ts : list ⇑type} -> {t : ⇑type} -> penv ts -> option ⇑t -> value -> option (penv ts).
matchCode P (some X) W = keepIf (eqValue (v X) W) P.
matchCode P none W = none.

matchVar : {ts : list ⇑type} -> {t : ⇑type} -> penv ts -> member t ts -> option ⇑t -> value -> option (penv ts).
matchVar {t := T} P I none W = optMap (pset P I) (codeAs T W).
matchVar P I (some X) W = matchCode P (some X) W.

matchTerm : {ts : list ⇑type} -> {t : ⇑type} -> penv ts -> cterm ts t -> value -> option (penv ts).
matchTerm P (cv I) W = matchVar P I (pget P I) W.
matchTerm P T W = matchCode P (pinst P T) W.

matchArgs : {ts ss : list ⇑type} -> penv ts -> cterms ts ss -> list value -> option (penv ts).
thenMatch : {ts ss : list ⇑type} -> option (penv ts) -> cterms ts ss -> list value -> option (penv ts).
matchArgs P tnil [] = some P.
matchArgs P (tcons T Ts) (W :: Ws) = thenMatch (matchTerm P T W) Ts Ws.
matchArgs P Ts Ws = none.
thenMatch (some P) Ts Ws = matchArgs P Ts Ws.
thenMatch none Ts Ws = none.

matchAtom : {ts : list ⇑type} -> penv ts -> catom ts -> gatom -> option (penv ts).
matchAtom P (cat R As) (atom S Ws) = thenMatch (keepIf (eqRref R S) P) As Ws.

optList : {A : Type} -> option A -> list A -> list A.
optList (some X) Xs = X :: Xs.
optList none Xs = Xs.

extend : {ts : list ⇑type} -> list gatom -> catom ts -> penv ts -> list (penv ts).
extend [] B P = [].
extend (G :: Gs) B P = optList (matchAtom P B G) (extend Gs B P).

search : {ts : list ⇑type} -> list gatom -> list (cbody ts) -> list (penv ts) -> list (penv ts).
search Gs [] Ps = Ps.
search Gs (cpos B :: Bs) Ps = search Gs Bs (concat (map (extend Gs B) Ps)).
search Gs (ccmp O L R :: Bs) Ps = search Gs Bs Ps.
search Gs (cnot Us B :: Bs) Ps = [].
search Gs (cagg Us O R T Cs :: Bs) Ps = [].

completes : {ts : list ⇑type} -> list (penv ts) -> list (env ts).
completes [] = [].
completes (P :: Ps) = optList (complete P) (completes Ps).

(* checking a valuation: the body's premises, with their derivations among the facts *)
eqCmp : {t : ⇑type} -> {x y : ⇑t} -> option (eq x y) -> option (holdsCmp ceq (some x) (some y)).
eqCmp (some refl) = some cmpEq.
eqCmp none = none.

neCmp : {t : ⇑type} -> {x y : ⇑t} -> dec (eq x y) -> option (holdsCmp cne (some x) (some y)).
neCmp (yes E) = none.
neCmp (no F) = some (cmpNe F).

ordInt : (o : cmp_op) -> (x y : ⇑int) -> option (holdsCmp o (some x) (some y)).
ordInt ceq X Y = eqCmp (fromDec (decEq X Y)).
ordInt cne X Y = neCmp (decEq X Y).
ordInt clt X Y = optMap (cmpLt {x := X} {y := Y}) (soIf (iless (intOf X) (intOf Y))).
ordInt cle X Y = optMap (cmpLe {x := X} {y := Y}) (soIf (ileq (intOf X) (intOf Y))).
ordInt cgt X Y = optMap (cmpGt {x := X} {y := Y}) (soIf (iless (intOf Y) (intOf X))).
ordInt cge X Y = optMap (cmpGe {x := X} {y := Y}) (soIf (ileq (intOf Y) (intOf X))).

orderAt : {t : ⇑type} -> option (eq t int) -> (o : cmp_op) -> (x y : ⇑t) -> option (holdsCmp o (some x) (some y)).
orderAt (some refl) O X Y = ordInt O X Y.
orderAt none O X Y = none.

decideCmp : {t : ⇑type} -> (o : cmp_op) -> (x y : option ⇑t) -> option (holdsCmp o x y).
decideCmp ceq (some X) (some Y) = eqCmp (fromDec (decEq X Y)).
decideCmp cne (some X) (some Y) = neCmp (decEq X Y).
decideCmp {t := T} O (some X) (some Y) = orderAt (fromDec (decEq T int)) O X Y.
decideCmp O X Y = none.

pposOpt : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> {b : catom ts} -> {r : rref} ->
          {vs : list value} -> {bs : list (cbody ts)} ->
          eq (instAtom xs b) (pat r (some vs)) -> option (derives p d (atom r vs)) -> option (premises p d xs bs) ->
          option (premises p d xs (cpos b :: bs)).
pposOpt E (some D) (some Ps) = some (ppos E D Ps).
pposOpt E X Y = none.

checkPos : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> {b : catom ts} -> {bs : list (cbody ts)} ->
           (q : patom) -> eq (instAtom xs b) q -> list (dfact p d) -> option (premises p d xs bs) ->
           option (premises p d xs (cpos b :: bs)).
checkPos (pat R (some Vs)) E Fs Ps = pposOpt E (findFact (atom R Vs) Fs) Ps.
checkPos (pat R none) E Fs Ps = none.

pcmpOpt : {p : program} -> {d : db} -> {ts : list ⇑type} -> {xs : env ts} -> {t : ⇑type} -> {o : cmp_op} ->
          {l r : cterm ts t} -> {bs : list (cbody ts)} ->
          option (holdsCmp o (instTerm xs l) (instTerm xs r)) -> option (premises p d xs bs) ->
          option (premises p d xs (ccmp o l r :: bs)).
pcmpOpt (some C) (some Ps) = some (pcmp C Ps).
pcmpOpt X Y = none.

checkBody : {p : program} -> {d : db} -> {ts : list ⇑type} -> list (dfact p d) -> (xs : env ts) ->
            (bs : list (cbody ts)) -> option (premises p d xs bs).
checkBody Fs Xs [] = some pnil.
checkBody Fs Xs (cpos B :: Bs) = checkPos {xs := Xs} {b := B} (instAtom Xs B) refl Fs (checkBody Fs Xs Bs).
checkBody Fs Xs (ccmp O L R :: Bs) =
  pcmpOpt {xs := Xs} {l := L} {r := R} (decideCmp O (instTerm Xs L) (instTerm Xs R)) (checkBody Fs Xs Bs).
checkBody Fs Xs (cnot Us B :: Bs) = none.
checkBody Fs Xs (cagg Us O R T Cs :: Bs) = none.

(* firing a rule: every instantiated head of a checked valuation, with its derivation *)
positions : {A : Type} -> (xs : list A) -> list { x : A, at : member x xs }.
positions [] = [].
positions (X :: Xs) = { x = X, at = here } :: later (positions Xs).

later : {A : Type} -> {y : A} -> {xs : list A} -> list { x : A, at : member x xs } -> list { x : A, at : member x (y :: xs) }.
later [] = [].
later (E :: Es) = { x = E.x, at = there E.at } :: later Es.

headFact : {p : program} -> {d : db} -> {c : crule} -> {xs : env c.vars} -> member c p.rules ->
           premises p d xs c.body -> (q : patom) -> member q (map (instAtom xs) c.heads) -> list (dfact p d).
headFact M Ps (pat R (some Vs)) At = [{ fact = atom R Vs, proof = fire M Ps At }].
headFact M Ps (pat R none) At = [].

headFacts : {p : program} -> {d : db} -> {c : crule} -> {xs : env c.vars} -> member c p.rules ->
            premises p d xs c.body -> list { x : patom, at : member x (map (instAtom xs) c.heads) } -> list (dfact p d).
headFacts M Ps [] = [].
headFacts M Ps (H :: Hs) = append (headFact M Ps H.x H.at) (headFacts M Ps Hs).

fromPremises : {p : program} -> {d : db} -> {c : crule} -> {xs : env c.vars} -> member c p.rules ->
               option (premises p d xs c.body) -> list (dfact p d).
fromPremises {c := C} {xs := Xs} M (some Ps) = headFacts M Ps (positions (map (instAtom Xs) C.heads)).
fromPremises M none = [].

fireAt : {p : program} -> {d : db} -> list (dfact p d) -> (c : crule) -> member c p.rules -> list (env c.vars) ->
         list (dfact p d).
fireAt Fs C M [] = [].
fireAt Fs C M (Xs :: Xss) = append (fromPremises {xs := Xs} M (checkBody Fs Xs C.body)) (fireAt Fs C M Xss).

fireRule : {p : program} -> {d : db} -> list (dfact p d) -> (c : crule) -> member c p.rules -> list (dfact p d).
fireRule Fs C M = fireAt Fs C M (completes (search (factsOf Fs) C.body [unbound C.vars])).

fireAll : {p : program} -> {d : db} -> list (dfact p d) -> list { x : crule, at : member x p.rules } -> list (dfact p d).
fireAll Fs [] = [].
fireAll Fs (R :: Rs) = append (fireRule Fs R.x R.at) (fireAll Fs Rs).

(* one round of naive evaluation: the facts so far, and the new ones that the rules derive from them *)
addFacts : {p : program} -> {d : db} -> list (dfact p d) -> list (dfact p d) -> list (dfact p d).
addFacts Fs [] = Fs.
addFacts Fs (N :: Ns) = addFacts (if (isSome (findFact N.fact Fs)) Fs (N :: Fs)) Ns.

nextRound : (p : program) -> {d : db} -> list (dfact p d) -> list (dfact p d).
nextRound P Fs = addFacts Fs (fireAll Fs (positions P.rules)).

rounds : (p : program) -> {d : db} -> nat -> list (dfact p d).
rounds P 0 = [].
rounds P (N + 1) = nextRound P (rounds P N).

(* `holds n p a`: `n` rounds of naive evaluation derive `a`, from no input facts. Sound for every
   database, by monotonicity *)
nothing : db = [a] empty.

holds : nat -> program -> gatom -> bool = [n] [p] [a] isSome (findFact a (rounds p {d := nothing} n)).

holdsSound : {d : db} -> (n : nat) -> (p : program) -> (a : gatom) -> so (holds n p a) -> derives p d a.
holdsSound N P A T = monotone ([b] [e] emptyElim e) (fromSome (findFact A (rounds P {d := nothing} N)) T).

derivable : {d : db} -> nat -> (p : program) -> decider gatom (derives p d).
derivable {d := D} N P = { check = holds N P, sound = holdsSound {d := D} N P }.
