(* issue #1, F3, and Proposition 8.8: the rule asserts `s (s N)`, a fact of the fact constructor `s`
   whose component comes before `d`'s, so it is split into `s (s N) :- s N`, evaluated in `s`'s component
   (see docs/NOTES.md). That rule makes new `s` facts that it matches again: `{s}` is a recursive
   component with a constructive rule *)
t : type. z : t. %fact s : t -> t.
b : t -> rel. b z.
d : t -> rel.
d z :- b z.
d X :- d X.
d (s (s N)) :- s N. (*~ E0603 *)
%output d.
