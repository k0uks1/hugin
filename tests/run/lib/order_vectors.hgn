(* a library whose export signature mentions a type that computes with a function by clauses written
   after it (issue #91): the export sees every case tree *)
%export { v2 : nat2, total : int }.
nat2 : Type = vec int (plus one one).
v2 : nat2 = vcons 10 (vcons 20 vnil).
total : int = vsum v2.
nat : Type. zero : nat. suc : nat -> nat.
one : nat = suc zero.
plus : nat -> nat -> nat.
plus zero N = N.
plus (suc M) N = suc (plus M N).
vec : Type -> nat -> Type.
vnil : vec A zero.
vcons : A -> vec A N -> vec A (suc N).
vsum : vec int N -> int.
vsum vnil = 0.
vsum (vcons X Xs) = X + vsum Xs.
