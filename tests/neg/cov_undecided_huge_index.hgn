(* #195: `cov_undecided.hgn` with a huge numeral (found by MutationFuzzSuite): index unification evaluates
   `double 9223372036854775807` to weak-head form only, one step that gives two successors, which refutes
   `vnil`; normalising it took 2^63 steps. The index is shown as it is: its normal form is too expensive
   (reference: meta/coverage, "Index unification") *)
double : nat -> nat.
double 0 = 0.
double (N + 1) = double N + 2.
vec : Type -> nat -> Type.
vnil : vec A 0.
vcons : A -> vec A N -> vec A (N + 1).
(* accepted: the first clause's split on `n` decides `vnil` *)
d : (n : nat) -> vec int (double n) -> int.
d 0 vnil = 0.
d (N + 1) (vcons X XS) = X.
(* rejected, as in Agda: the clause's only position is undecided *)
e : (n : nat) -> vec int (double n) -> int.
e N vnil = 0. (*~ E0915 *)
e (N + 1) (vcons X XS) = X.
(* accepted: `vnil` is undecided until the split on `refl` solves `n` *)
same : nat -> nat -> Type.
refl : same N N.
empty : {n : nat} -> vec int (double n) -> same n 9223372036854775807 -> int.
empty vnil refl = 0. (*~ E0915 *)
(* accepted: `0 = double n` is postponed until `0 = n` solves `n` *)
pair : nat -> nat -> Type.
mk : pair 0 0.
z : (n : nat) -> pair (double n) n -> nat.
z N mk = N.
