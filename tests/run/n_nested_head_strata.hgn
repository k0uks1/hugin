(* Proposition 8.8: the split rule `mk N :- src N` of `h`'s first rule depends only on that rule's body, not
   on `h`'s other rules. `h` reads `q`, which negates `r`, which reads `mk`: the program is stratified
   (`src, mk, r, q, h`) and accepted. Ordering `mk` after `h` (an edge `mk -> h`) would put `mk`, `r`, `q`
   and `h` in one component with a negation, and reject it *)
w : type.
mk : int -> w.
src : int -> rel.
src 1. src 2.
r : int -> rel.
r N :- mk N.
q : int -> rel.
q N :- src N, not r 3.
h : w -> rel.
h (mk N) :- src N.
h X :- q N, X = mk N.
?- r N.
?- h X.
