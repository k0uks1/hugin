(* Constructor terms in demanded inputs: the demand rule of a call asserts its inputs (`area.check
   (square 4)`), so the term becomes a fact, as any term a head builds (REDESIGN §8.1). A fact bound first
   can be passed through a variable, and a constructor pattern in the input column of `area`'s own head
   matches the demand. *)
shape : type.
circle : shape.
square : int -> shape.
named : string -> shape.
named "unit".

area : (s : shape) -> (a : int) -> rel.
%demand area +s -a.
area circle 3.
area (square N) A :- A = N * N.
area (named _) 1.

(* the demand of `area` asserts `square 4` *)
q : int -> rel.
q A :- area (square 4) A.
%output q.

(* an existing fact of `named`, bound first, is passed through a variable *)
r : string -> int -> rel.
r N A :- named N, S = named N, area S A.
%output r.

(* the facts of `named`: the demands of `area` added none (no call builds a `named` term) *)
seen : string -> rel.
seen N :- named N.
%output seen.
counted : int -> rel.
counted C :- C = count { S | named S }.
%output counted.

?- area (square 3) A.
?- area circle A.
