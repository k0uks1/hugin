(* Quoted syntax that has no reflective representation (an ascription in a pattern, whose type is code), holes in the wrong places, and quotes whose
   content is not of the category the expected type needs (E0917). *) %use "std/reflect".
p : int -> rel.
q : int -> int -> rel.
f : int -> int = %postulate.

lambda : rule = '( p X :- q X ([y] y) ). (*~ E0917 *)
ascribed : formula -> int.
ascribed '( p ($X : int) ) = 1. (*~ E0917 *)
ascribed _ = 0.
misplaced : formula = '( $..Xs ). (*~ E0917 *)

firstArgs : formula -> list term.
firstArgs '( q $..Xs $Y ) = Xs. (*~ E0917 *)
firstArgs _ = [].

hole : formula -> int.
hole '( p $(f 1) ) = 1. (*~ E0917 *)
hole _ = 0.

higher : formula -> int.
higher '( p $F[X] ) = 1. (*~ E0917 *)
higher _ = 0.

(* holes outside a quote, a rule where a formula is expected, a quote of formulas as a list *)
outside : list term = [$..Ts]. (*~ E0917 *)
shape : formula = '( p 1 :- q 1 2 ). (*~ E0917 *)
several : rule = '( p 1. p 2. ). (*~ E0917 *)
category : list formula = '( p 1, p 2 ). (*~ E0917 *)
