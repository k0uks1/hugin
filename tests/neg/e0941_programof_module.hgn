(* The argument of `programOf` is not a functor, a functor application or a module (E0941). `here`, the
   program of the current file, is accepted (#186 P9f): the declaration is elaborated after the file's
   rules. *)
%use "std/semantics".
%use "std/quote".
three : int = 3.
p : program = programOf three. (*~ E0941 *)
q : program = programOf here.
%opaque q.
