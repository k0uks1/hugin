(* Numerals of the prelude's `nat` are shown as digits (reference: meta/families, numerals). *)
two : nat = 1 + 1.
vec : Type -> nat -> Type.
vnil : vec A 0.
vcons : A -> vec A N -> vec A (suc N).
:type vcons
:print elaborate two
(* A meta function without clauses is rejected: a function and its clauses are one input. *)
pred : nat -> nat.
pred : nat -> nat. pred (N + 2) = N.
:quit
