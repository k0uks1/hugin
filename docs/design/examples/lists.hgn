(* Today's duplication of lists (issue #52). The prelude declares the object type `list` (`nil`, `cons`)
   and the meta type `seq` (`snil`, `scons`, written `[]`, `x :: xs`). A program that builds a list at
   compile time and stores it as a fact writes the conversion by hand, once into object code (`⇑`) and
   once into reflected syntax (`term`), and writes the length twice: as a meta function and as the
   prelude's relation `len`. *)

(* The conversion into object code: the fold of `seq` into the object constructors. *)
lift : (A -> ⇑B) -> seq A -> ⇑(list B).
lift F [] = nil.
lift F (X :: Xs) = cons (F X) (lift F Xs).

(* The same conversion into reflected syntax, for directives that build rules. With the explicit quotes
   of issue #76 the second clause reads `reify F (X :: Xs) = '{ cons $(F X) $(reify F Xs) }`. *)
reify : (A -> term) -> seq A -> term.
reify F [] = nil.
reify F (X :: Xs) = cons $(F X) $(reify F Xs).

(* The length at compile time; the prelude's `len` is the length of the lists that are facts. *)
slen : seq A -> int.
slen [] = 0.
slen (X :: Xs) = slen Xs + 1.

(* Persistence of an `int` as a function, to pass to `lift`. *)
persist : int -> ⇑int.
persist X = X.

primes : seq int = [2, 3, 5, 7].

held : list int -> rel.
held (lift persist primes).

(* A directive-style generator: one fact per suffix, built as data. With #76 the element is the fact
   `'{ held $(reify tint (X :: Xs)) }`; the empty-body form `(h :-)` goes away. *)
suffixes : seq int -> seq rule.
suffixes [] = [].
suffixes (X :: Xs) = (held $(reify tint (X :: Xs)) :-) :: suffixes Xs.
$suffixes [11, 13].

static_len : int -> rel.
static_len (slen primes).

?- held L, len L N.
%output static_len.
