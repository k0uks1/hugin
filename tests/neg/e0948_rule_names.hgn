(* A rule name `r.k` must name a rule of the program whose head matches the goal, with its premises, and is
   used where a derivation of a known program is expected (E0948). *)
%use "std/graph".
%use "std/semantics".
third : {x y : G.node} -> tc G ⊢ G.edge x y -> tc G ⊢ path x y.
third E = path.3 E. (*~ E0948 *)
mismatch : {x y : G.node} -> tc G ⊢ path x y -> tc G ⊢ G.edge x y.
mismatch (path.1 E) = path.1 E. (*~ E0948 *)
premises : {x y : G.node} -> tc G ⊢ G.edge x y -> tc G ⊢ path x y.
premises E = path.1 E E. (*~ E0948 *)
variable : {x y : G.node} -> tc G ⊢ G.edge x y -> tc G ⊢ path x y.
variable E = path.1 {W := x} E. (*~ E0948 *)
nowhere : int = path.1. (*~ E0948 *)
counter = {
  small : int -> rel.
  big : int -> rel.
  small 3.
  big X :- small X, X > 10.
}.
tooSmall : counter ⊢ big 3 = big.1 small.1. (*~ E0948 *)
