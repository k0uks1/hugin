(* std/demand: `%demand r +e +g -t.` (reference: directives) makes `r` demand-driven, by the magic-sets
   transformation written as ordinary rules. A relation `r.check` over the input columns of `r` is the
   demand: every rule of `r` is guarded by it (`r … :- r.check …, body`), and every call of `r` (in any
   rule or query of the module) passes its inputs as demand, from the conjuncts before it
   (`r.check t̄ :- prefix`): a seed rule outside `r`, a propagation rule inside it. The modes are typed by
   the labels of `r`'s columns (`modes (labels r)`): `+e` must name the first column, a plain `+` or `-`
   any. The module exports `demand` only: its helpers are outside its signature. *)
%use "std/reflect".
%export { demand : (r : sym) -> modes (labels r) -> module -> module }.

demand : (r : sym) -> modes (labels r) -> module -> module.
demand R M Is = irelation (derive R "check") (dcolumns R izero M) :: dmodule R (derive R "check" :: ddemanded Is) M [] Is.

(* The demand relations declared in the module *)
ddemanded : module -> list sym.
ddemanded [] = [].
ddemanded (irelation D Cols :: Is) = D :: ddemanded Is.
ddemanded (I :: Is) = ddemanded Is.

(* The columns of the demand relation: the inputs of `r` *)
dcolumns : sym -> index -> modes Ls -> list column.
dcolumns R K mnone = [].
dcolumns R K (minput L M) = colof R K :: dcolumns R (isuc K) M.
dcolumns R K (moutput L M) = dcolumns R (isuc K) M.

(* The arguments at the inputs *)
dinputs : modes Ls -> list term -> list term.
dinputs (minput L M) (T :: Ts) = T :: dinputs M Ts.
dinputs (moutput L M) (T :: Ts) = dinputs M Ts.
dinputs M Ts = [].

(* The wildcards of the inputs of a guarded head named (`_a#0`, `_ba#0`, …), so that the guard binds them;
   source syntax cannot write `#`, so a program's variables cannot capture these (hygiene) *)
dnamed : string -> modes Ls -> list term -> list term.
dnamed P (minput L M) (T :: Ts) = dname (P ^ "a") T :: dnamed (P ^ "b") M Ts.
dnamed P (moutput L M) (T :: Ts) = T :: dnamed (P ^ "b") M Ts.
dnamed P M Ts = Ts.

dname : string -> term -> term.
dname P twild = tvar (P ^ "#0").
dname P (tapp S Ts) = tapp S (dnames P Ts).
dname P T = T.

dnames : string -> list term -> list term.
dnames P [] = [].
dnames P (T :: Ts) = dname (P ^ "a") T :: dnames (P ^ "b") Ts.

(* The module: `G` is the guard of the last rule of `r`; the rules derived from a rule follow it, so the
   demand rules an earlier `%demand` generated from a rule of `r` are guarded with it (the order of the
   `%demand` directives does not matter) *)
dmodule : sym -> list sym -> modes Ls -> list formula -> module -> module.
dmodule R Cs M G [] = [].
dmodule R Cs M G (irule Rl :: Is) = append (dstep R Cs M G Rl irule) (dmodule R Cs M (dguardOf R M Rl G) Is).
dmodule R Cs M G (inamed N Rl :: Is) = append (dstep R Cs M G Rl (inamed N)) (dmodule R Cs M (dguardOf R M Rl G) Is).
dmodule R Cs M G (iquery B :: Is) = iquery B :: append (ditems (dcalls R Cs M [] B)) (dmodule R Cs M [] Is).
dmodule R Cs M G (I :: Is) = I :: dmodule R Cs M [] Is.

(* A rule: of `r` guarded, with the demand of its calls; derived from the last rule of `r`, guarded like
   it; any other with the demand of its calls *)
dstep : sym -> list sym -> modes Ls -> list formula -> rule -> (rule -> item) -> module.
dstep R Cs M G '{ $S $..Ts :- $..B } Mk = dhead (same R S) (derived S) R Cs M G S Ts B Mk.
dstep R Cs M G Rl Mk = Mk Rl :: ditems (dbody R Cs M Rl).

dhead : bool -> bool -> sym -> list sym -> modes Ls -> list formula -> sym -> list term -> list formula -> (rule -> item) -> module.
dhead true D R Cs M G S Ts B Mk = dguarded (dguard R M Ts) S (dnamed "_" M Ts) B Mk :: ditems (dcalls R Cs M [dguard R M Ts] B).
dhead false true R Cs M G S Ts B Mk = [Mk (horn [fatom S Ts] (dprefix Cs Ts (append G B)))].
dhead false false R Cs M G S Ts B Mk = Mk '{ $S $..Ts :- $..B } :: ditems (dcalls R Cs M [] B).

dguarded : formula -> sym -> list term -> list formula -> (rule -> item) -> item.
dguarded F S Ts B Mk = Mk '{ $S $..Ts :- $F, $..B }.

(* The guard of a rule of `r` with head arguments `Ts` *)
dguard : sym -> modes Ls -> list term -> formula.
dguard R M Ts = fatom (derive R "check") (dinputs M (dnamed "_" M Ts)).

(* The guard the rules after `Rl` get: `Rl`'s if it is a rule of `r`, `G` if it is derived *)
dguardOf : sym -> modes Ls -> rule -> list formula -> list formula.
dguardOf R M '{ $S $..Ts :- $..B } G = dguardSel (same R S) (derived S) (dguard R M Ts) G.
dguardOf R M Rl G = [].

dguardSel : bool -> bool -> formula -> list formula -> list formula.
dguardSel true D F G = [F].
dguardSel false true F G = G.
dguardSel false false F G = [].

dbody : sym -> list sym -> modes Ls -> rule -> list rule.
dbody R Cs M (horn Hs B) = dcalls R Cs M [] B.

(* The demand of the calls of `r` among the formulas `Fs`, each from the formulas before it *)
dcalls : sym -> list sym -> modes Ls -> list formula -> list formula -> list rule.
dcalls R Cs M Pre [] = [].
dcalls R Cs M Pre (F :: Fs) = append (dcall R Cs M Pre F) (dcalls R Cs M (append Pre [F]) Fs).

dcall : sym -> list sym -> modes Ls -> list formula -> formula -> list rule.
dcall R Cs M Pre (fatom S Ts) = ddemand (same R S) R Cs M Pre Ts.
dcall R Cs M Pre (fnot F) = dcall R Cs M Pre F.
dcall R Cs M Pre (fconj F G) = append (dcall R Cs M Pre F) (dcall R Cs M (append Pre [F]) G).
dcall R Cs M Pre (fdisj F G) = append (dcall R Cs M Pre F) (dcall R Cs M Pre G).
dcall R Cs M Pre (fagg O X T F) = dinner R Cs M Pre F.
dcall R Cs M Pre F = [].

(* In an aggregate, the demand of a call is built from the formulas before the aggregate (the formulas
   in it may mention its variable): the call's inputs must be bound outside it *)
dinner : sym -> list sym -> modes Ls -> list formula -> formula -> list rule.
dinner R Cs M Pre (fatom S Ts) = ddemand (same R S) R Cs M Pre Ts.
dinner R Cs M Pre (fnot F) = dinner R Cs M Pre F.
dinner R Cs M Pre (fconj F G) = append (dinner R Cs M Pre F) (dinner R Cs M Pre G).
dinner R Cs M Pre (fdisj F G) = append (dinner R Cs M Pre F) (dinner R Cs M Pre G).
dinner R Cs M Pre (fagg O X T F) = dinner R Cs M Pre F.
dinner R Cs M Pre F = [].

ddemand : bool -> sym -> list sym -> modes Ls -> list formula -> list term -> list rule.
ddemand true R Cs M Pre Ts = [horn [fatom (derive R "check") (dinputs M Ts)] (dprefix Cs (dinputs M Ts) Pre)].
ddemand false R Cs M Pre Ts = [].

(* The formulas a demand rule keeps of the prefix of a call with inputs `Is` (reference: directives):
   demand rules are positive and do not wait for answers they do not need. A negation is dropped; a call
   of a demand-driven relation (with a demand relation among `Cs`) or an aggregate is kept only if it
   binds a variable that the inputs or the kept formulas need and that they do not bind themselves. So
   the demand of a relation is evaluated before it (by descent) unless an input is an answer of an
   earlier call, and it never depends negatively on the relations that call it. Keeping fewer formulas
   only adds demand, never answers. Demand rules generated earlier (by `%demand` of another relation)
   are pruned in the same way. *)
dprefix : list sym -> list term -> list formula -> list formula.
dprefix Cs Is Pre = dpruned Cs Pre (dneed Cs Pre (dkeepCalls Cs (dneed Cs Pre [] Is) Pre) Is).

(* The variables needed by the inputs and by the formulas `Kept` (all, or kept by a first round, which
   adds the needs of a kept aggregate) that the other formulas do not bind *)
dneed : list sym -> list formula -> list formula -> list term -> list string.
dneed Cs Pre Kept Is =
  sdiff (append (tsvars Is) (append (dothers Cs fneeds Pre) (dallneeds Kept))) (dothers Cs fbound Pre).

dallneeds : list formula -> list string.
dallneeds [] = [].
dallneeds (F :: Fs) = append (fneeds F) (dallneeds Fs).

dpruned : list sym -> list formula -> list string -> list formula.
dpruned Cs Pre Need = dkeepCalls Cs Need Pre.

dkeepCalls : list sym -> list string -> list formula -> list formula.
dkeepCalls Cs Need [] = [].
dkeepCalls Cs Need (F :: Fs) = dkeepF Cs Need F (dkeepCalls Cs Need Fs).

dkeepF : list sym -> list string -> formula -> list formula -> list formula.
dkeepF Cs Need (fatom S Ts) Fs = dkeepIf (msym (derive S "check") Cs) (shares (tsvars Ts) Need) (fatom S Ts) Fs.
dkeepF Cs Need (fnot F) Fs = Fs.
dkeepF Cs Need (fagg O X T F) Fs = dkeepIf true (shares (tvarsOf X) Need) (fagg O X T F) Fs.
dkeepF Cs Need F Fs = F :: Fs.

dkeepIf : bool -> bool -> formula -> list formula -> list formula.
dkeepIf true false F Fs = Fs.
dkeepIf C N F Fs = F :: Fs.

(* Whether a formula may be left out of a demand rule *)
dcallOf : list sym -> formula -> bool.
dcallOf Cs (fatom S Ts) = msym (derive S "check") Cs.
dcallOf Cs (fnot F) = true.
dcallOf Cs (fagg O X T F) = true.
dcallOf Cs F = false.

msym : sym -> list sym -> bool.
msym S [] = false.
msym S (C :: Cs) = bor (same S C) (msym S Cs).

(* The variables `V` gives of the formulas that are not such calls *)
dothers : list sym -> (formula -> list string) -> list formula -> list string.
dothers Cs V [] = [].
dothers Cs V (F :: Fs) = append (dunless (dcallOf Cs F) (V F)) (dothers Cs V Fs).

dunless : bool -> list string -> list string.
dunless true Xs = [].
dunless false Xs = Xs.

(* Variables of terms and formulas; those a formula binds (an atom all of its own, an equation those of
   its sides without arithmetic, an aggregate its result) and those it needs bound *)
tvarsOf : term -> list string.
tvarsOf (tvar X) = [X].
tvarsOf (tapp S Ts) = tsvars Ts.
tvarsOf (tarith O A B) = append (tvarsOf A) (tvarsOf B).
tvarsOf (tneg A) = tvarsOf A.
tvarsOf T = [].

tsvars : list term -> list string.
tsvars [] = [].
tsvars (T :: Ts) = append (tvarsOf T) (tsvars Ts).

fvars : formula -> list string.
fvars (fatom S Ts) = tsvars Ts.
fvars (fcmp C A B) = append (tvarsOf A) (tvarsOf B).
fvars (fnot F) = fvars F.
fvars (fconj F G) = append (fvars F) (fvars G).
fvars (fdisj F G) = append (fvars F) (fvars G).
fvars (fagg O X T F) = append (tvarsOf X) (append (tvarsOf T) (fvars F)).

fbound : formula -> list string.
fbound (fatom S Ts) = tsvars Ts.
fbound (fcmp ceq A B) = dequation (plain A) (plain B) A B.
fbound (fagg O X T F) = tvarsOf X.
fbound (fconj F G) = append (fbound F) (fbound G).
fbound F = [].

dequation : bool -> bool -> term -> term -> list string.
dequation true true A B = append (tvarsOf A) (tvarsOf B).
dequation true false A B = tvarsOf A.
dequation false true A B = tvarsOf B.
dequation false false A B = [].

fneeds : formula -> list string.
fneeds F = sdiff (fvars F) (fbound F).

(* a term without arithmetic: a pattern *)
plain : term -> bool.
plain (tapp S Ts) = plains Ts.
plain (tarith O A B) = false.
plain (tneg A) = false.
plain T = true.

plains : list term -> bool.
plains [] = true.
plains (T :: Ts) = band (plain T) (plains Ts).

(* Booleans and lists of strings as sets *)
band : bool -> bool -> bool.
band true B = B.
band false B = false.

bor : bool -> bool -> bool.
bor true B = true.
bor false B = B.

member : string -> list string -> bool.
member X [] = false.
member X (Y :: Ys) = bor (same X Y) (member X Ys).

sdiff : list string -> list string -> list string.
sdiff [] Ys = [].
sdiff (X :: Xs) Ys = dkeepS (member X Ys) X (sdiff Xs Ys).

dkeepS : bool -> string -> list string -> list string.
dkeepS true X Zs = Zs.
dkeepS false X Zs = X :: Zs.

shares : list string -> list string -> bool.
shares [] Ys = false.
shares (X :: Xs) Ys = bor (member X Ys) (shares Xs Ys).

ditems : list rule -> module.
ditems [] = [].
ditems (Rl :: Rls) = irule Rl :: ditems Rls.
