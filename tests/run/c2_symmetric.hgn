(* A user-defined directive (docs/REDESIGN.md §8.5): `symmetric` returns items, so `%symmetric friend.`
   adds them where it stands (an additive directive). The relation is passed as object code
   `⇑(A -> A -> rel)`; in the quoted rule, `R` is that relation. *)
person : type.
ann : person. bob : person. cid : person.

symmetric : (r : ⇑(A -> A -> rel)) -> list item.
symmetric R = '{ R Y X :- R X Y. }.

friend : person -> person -> rel.
%symmetric friend.
friend ann bob.
friend bob cid.

(* the same with a symbol: `$R` splices it into the quoted rule *)
symmetric2 : sym -> list item.
symmetric2 R = '{ $R Y X :- $R X Y. }.

knows : person -> person -> rel.
%symmetric2 knows.
knows cid ann.

%output friend.
%output knows.
