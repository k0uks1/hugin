(* E0307: duplicate labels; E0304/E0305: projection on a union needs a common label with a join *)
sig : Type = { a : type, a : type }.
rec = { n = 1, n = 2 }.
pt : type = { x : int, y : int }.
qt : type = { x : int, z : int }.
st : type = { x : string, y : int }.
both : pt | qt -> rel.
mixed : pt | st -> rel.
ys : int -> rel.
ys V :- both P, V = P.y.
xs : int -> rel.
xs V :- mixed P, V = P.x.
named : rel.
named :- pt { x = 1, x = 2, y = 3 }.
