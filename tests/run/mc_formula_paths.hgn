(* The cycle check of formula functions follows only the member a path selects (issue #151): `f` uses
   `m.a`, and a different member `m.b` of the same body uses `f`, which closes no cycle; so do a member
   reached through a nested path and one of a functor instance. The instance `inst`, in a cycle of items
   with `mk` and `h`, is named after its definition and created once (`inst.more`). *)
edge : int -> int -> rel.
edge 1 2. edge 2 3. edge 3 4.

f : int -> prop.
f X :- m.a X.
m = {
  a : int -> prop.
  a X :- edge X _.
  b : int -> prop.
  b X :- edge _ X, f X.
  c : int -> prop = [X] f X.
  both : int -> rel.
  both X :- b X, c X.
}.

(* through a nested path *)
g : int -> prop.
g X :- n.inner.a X.
n = {
  inner = {
    a : int -> prop.
    a X :- edge _ X.
    b : int -> prop.
    b X :- g X.
  }.
  hits : int -> rel.
  hits X :- edge X _, inner.b X.
}.

(* through a functor instance *)
mk (r : int -> int -> rel) = {
  a : int -> prop.
  a X :- r X _.
  b : int -> prop.
  b X :- r _ X, h X.
  more : int -> rel.
  more X :- a X.
}.
inst = mk edge.
h : int -> prop.
h X :- inst.a X.
viaH : int -> rel.
viaH X :- h X.

viaM : int -> rel.
viaM X :- m.both X.
viaN : int -> rel.
viaN X :- n.hits X.
viaInst : int -> rel.
viaInst X :- inst.more X.
%output viaM.
%output viaN.
%output viaInst.
%output viaH.
%output inst.more.
