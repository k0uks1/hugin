(* Section 11: a functor that negates or aggregates over a parameter must require %complete. *)
g : mod = { node : type, edge : node -> node -> rel }.
sinks (x : g) = {
  sink : x.node -> rel.
  sink N :- x.edge _ N, not x.edge N _.
  outdeg : x.node -> int -> rel.
  outdeg N D :- x.edge N _, D = count { M | x.edge N M }.
}.
without (r : A -> rel) (s : A -> rel) = {
  diff : A -> rel.
  diff X :- r X, not s X.
}.
