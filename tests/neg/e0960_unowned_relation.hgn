(* #186 P9b: an applied relation that no program owns is not coerced to a judgment and stays E0960, whose
   help names the turnstile: a variable's relation (every program over `G` reads it), a relation of the
   file and a relation of the enclosing body (until locale-style proofs, P9f/P9g). *)
%use "std/graph".
%use "std/semantics".

city : type. berlin, paris : city.
road : city -> city -> rel.
%input road.

edgeIn : {x y : G.node} -> G.edge x y -> tc G ⊢ G.edge x y. (*~ E0960 *)
edgeIn E = E.

file : {x y : city} -> road x y -> Type. (*~ E0960 *)
file _ = Type.

tc3 (g : graph) = { (*~ W0003 *)
  path : g.node -> g.node -> rel.
  path X Y :- g.edge X Y.
  inside : {x y : g.node} -> path x y -> Type. (*~ E0960 *)
  inside _ = Type.
}.
