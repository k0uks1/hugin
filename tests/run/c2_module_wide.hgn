(* A module-wide directive (type `module -> module`) rewrites the rules and queries of the file: here
   every rule deriving `edge` derives the reversed edge as well. Directives are expanded in source
   order: the module `%mirror` rewrites contains the rules added by `%loop` before it, but not those of
   `%loop` after it. Items it passes on unchanged keep their places. *)
node : type.
a : node. b : node. c : node. d : node.
edge : node -> node -> rel.
path : node -> node -> rel.
edge a b.
edge b c.
path X Y :- edge X Y.
path X Z :- path X Y, edge Y Z.

mirror : module -> module.
mirror [] = [].
mirror ('{ edge $X $Y :- $..B } :: Rest) = '{ edge $X $Y :- $..B } :: '{ edge $Y $X :- $..B } :: mirror Rest.
mirror (I :: Rest) = I :: mirror Rest.

(* an edge from a node to `d` *)
loop : term -> list item.
loop N = '{ edge $N d. }.

%loop c.
%mirror.
%loop a.
?- path d X.
