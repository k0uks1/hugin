(* A definition whose body has a syntax error keeps its declaration: uses of its name are not reported as
   unresolved (no E0101); the items using it are dropped silently. *)
nat : Type.
zero : nat.
suc : nat -> nat.
double : nat -> nat.
double zero = zero.
double (suc N) = suc (suc (double N). (*~ E0005 *)
four = double (double (suc zero)).
two : nat = suc (suc zero +). (*~ E0001 *)
three = suc two.
one = suc zero.
five : nat = suc (suc (suc one)).
six = suc five.
