(* A function whose clause uses an undefined name (issue #108): `pick` is dropped (E0101), so `grow`
   builds stuck code in which each level refers to the level below twice and splits on it. The value
   has linear size but an exponential tree; compilation reports it at once and shows it in part. *)
pick : bool -> A -> A -> A.
pick B X Y = choose B X Y. (*~ E0101 *)
first : list int -> int.
first [] = 0.
first (X :: Xs) = X.
nat : Type.
zero : nat.
suc : nat -> nat.
twenty : nat = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))).
grow : nat -> list int -> list int.
grow zero R = R.
grow (suc N) R = grow N (pick true (first R :: R) R).
size : list int -> int.
size [] = 0.
size (X :: Xs) = size Xs + 1.
measured : int -> rel.
measured (size (grow twenty [1])). (*~ E0909 *)
