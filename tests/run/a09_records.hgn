(* A.2 (9): records: named patterns, projection on a closed union, update *)
name : type = string.
span : type = { file : string, line : int }.
var  : (loc : span) -> (name : name) -> rel.
abs  : (loc : span) -> (name : name) -> (body : term) -> rel.
term : type = var | abs.

unbound : term -> rel.
report  : span -> rel.
@r_rep    report (E.loc) :- unbound E.
binder  : name -> rel.
@r_bind   binder N :- abs { name = N, .. }.
moved   : term -> rel.
@r_move   moved (E with { loc = span "b.hgn" 1 }) :- unbound E.

unbound (var (span "a.hgn" 3) "x").
unbound (abs (span "a.hgn" 7) "y" (var (span "a.hgn" 8) "y")).
%output report. %output binder. %output moved.
