(* E0504: a call of a moded relation builds its inputs (as the demand of the call), so an input that
   contains a term of a `%fact` constructor, at any depth, would make that term a fact: `%mode` would
   change the database. Calls in bodies, under `not`, in aggregates and in queries are checked; data
   terms, variables, and the input columns of the moded relation's own heads (patterns) are fine. *)
shape : type.
circle : shape.
%fact square : int -> shape.
box : shape -> shape.

area : (s : shape) -> (a : int) -> rel.
%mode area +s -a.
%terminates s area.
area circle 3.
area (square N) A :- A = N * N.
area (box S) A :- area S A.

q : int -> rel.
q A :- area (square 4) A. (*~ E0504 *)

nested : int -> rel.
nested A :- area (box (square 2)) A. (*~ E0504 *)

negated : rel.
negated :- not area (square 3) 9. (*~ E0504 *)

counted : int -> rel.
counted C :- C = count { A | area (square 5) A }. (*~ E0504 *)

(* fine: a data term, and an existing fact bound to a variable first *)
fine : int -> rel.
fine A :- area (box circle) A.
square 6.
bound : int -> rel.
bound A :- S = square 6, area S A.

?- area (square 7) A. (*~ E0504 *)
