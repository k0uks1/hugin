(* What a module body still does not support (E0907, issue #100), each with a subject of its own, and
   without cascades: the uses of a rejected member are not reported. *)
node : type.
edge : node -> node -> rel.
m = {
  small : type <: int. (*~ E0907 *)
  pairs (A : type) : type. (*~ E0907 *)
  color : Type. (*~ E0907 *)
  red : color.
  pick : color -> int.
  pick red = 1.
  stuck : int -> int. (*~ E0907 *)
  near : node -> prop. (*~ E0907 *)
  near X :- edge X _.
  hub : node -> rel.
  hub X :- near X.
  tiny : small -> rel.
  twice : int -> int.
  twice N = stuck (stuck N).
}.
