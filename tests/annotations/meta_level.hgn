(* annotations of meta-level names: meta functions, functors, their uses, a module path *)
nat : Type.
zero : nat.
suc : nat -> nat.
double : nat -> nat.
double zero = zero.
double (suc N) = suc (suc (double N)).
four : nat = double (suc (suc zero)).
item : (name : string) -> (price : int) -> rel.
listed : item -> rel.
%input listed.
select (p : item -> prop) = {
  sel : item -> rel.
  sel I :- listed I, p I.
}.
cheap : item -> prop = [I] I.price < 10.
bargains = select cheap.
%output bargains.sel.
