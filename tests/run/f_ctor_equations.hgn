(* Binding equations and comparisons with constructor terms (reference: object/facts). Every constructor
   is a fact constructor and bodies never create facts: `X = c t̄` is an existence check, read as
   `(c t̄ as X)`, also for the subterms of a nested term. Comparisons are structural: a constructor term
   that is not a fact differs from every value and equals a term of the same structure, without becoming
   a fact. *)
n : int -> rel.
n 1. n 2.

(* `some N` was never built: the equation does not hold *)
opt : option int -> rel.
opt X :- n N, X = some N.
%output opt.
wrapped : list (option int) -> rel.
wrapped L :- n N, L = cons (some N) nil.
%output wrapped.

(* fact constructor: only existing facts bind *)
point : type.
pt : int -> point.
pt 1.
found : int -> point -> rel.
found N X :- n N, X = pt N.
%output found.
(* nested: every subterm must be a fact *)
listed : list point -> rel.
listed L :- n N, L = cons (pt N) nil.
%output listed.

(* structural comparisons with the never-built `pt 9`: no fact `pt 9` is created *)
same : rel.
same :- pt 9 = pt 9.
%output same.
differs : point -> rel.
differs X :- found _ X, X <> pt 9.
%output differs.
equal : point -> rel.
equal X :- found _ X, X = pt 9.
%output equal.
nested : rel.
nested :- listed L, L <> cons (pt 9) nil.
%output nested.
points : int -> rel.
points N :- pt N.
%output points.
