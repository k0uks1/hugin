(* Range restriction and modes (Section 6.3). *)
edge : int -> int -> rel.
fib : (n : int) -> (f : int) -> rel.
%mode fib +n -f.
unsafe : int -> rel.
unsafe X :- not edge X 1.
free : int -> int -> rel.
free X Y :- edge X _.
cmp : int -> rel.
cmp X :- X < 3.
call : int -> rel.
call F :- fib N F.
fib (N + 1) F :- edge N F.
