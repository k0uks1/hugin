(* A space between the prime and the parenthesis of a quote is reported once, and the quote is read; a
   quote that a `]` ends before its `)` is unclosed (E0005), without an error for the entry. *)
%use "std/reflect".
expr : type. ctx : type. e0 : expr. g0 : ctx.
neg : expr -> expr.
asked : (e : expr) -> (g : ctx) -> rel.
guard : rule -> list rule.
guard '( asked (neg $E) $G :- $..B ) = [ ' (( asked $E $G :- asked (neg $E) $G )]. (*~ E0001 *) (*~ E0005 *)
guard R = [R].
spaced : rule = ' ( asked e0 g0 ). (*~ E0001 *)
$[spaced].
