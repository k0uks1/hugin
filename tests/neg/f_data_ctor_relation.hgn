(* E0406: a data constructor (or data struct) is not a relation: it builds values, which are not facts.
   Reading it in a body, a negation, an aggregate or a query, deriving it in a rule head, naming it in a
   directive and passing it where a relation is expected are errors; terms built with it are fine. *)
shape : type.
circle : shape.
square : int -> shape.
pt : type = { x : int, y : int }.

has : shape -> rel.
has circle.
has (square 2).

body : int -> rel.
body N :- square N.
negated : shape -> rel.
negated S :- has S, not square 2.
counted : int -> rel.
counted C :- C = count { N | square N }.
square 3 :- has circle.
points : int -> rel.
points X :- pt { x = X, y = _ }.
%output square.
?- square N.
?- cons X nil.

(* a data constructor passed where a relation is expected, and a data-constructor field read in a functor *)
closure (g : { node : type, edge : node -> node -> rel }) = {
  reach : g.node -> g.node -> rel.
  reach X Y :- g.edge X Y.
}.
pair_sig : Type = { node : type, link : int -> node }.
scan (p : pair_sig) = {
  linked : int -> rel.
  linked X :- p.link X.
}.
bad_closure = closure { node = shape, edge = square }.
scanned = scan { node = shape, link = square }.

(* fine: terms built with data constructors, in heads, patterns, comparisons and aggregates *)
ok : shape -> rel.
ok (square 4).
ok S :- has S, S <> square 3, S = square _.
sizes : int -> rel.
sizes N :- has (square N).
total : int -> rel.
total T :- T = sum { N | has (square N) }.
