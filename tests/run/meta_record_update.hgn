(* Updates of meta records (reference: meta/records): in a definition, in a function, of a record with
   a dependent field, and of a functor argument; the object-level update is unchanged. *)
point : Type = { x : int, y : int }.
origin : point = { x = 0, y = 0 }.
moved : point = (origin with { x = 5 }).
raise : point -> point = [p] (p with { y = p.y + 10 }).
both : point = (origin with { x = 1, y = 2 }).
at : int -> int -> rel.
at moved.x moved.y.
at (raise moved).x (raise moved).y.
at both.x both.y.

boxed : Type = { t : Type, v : t }.
parcel : boxed = { t = string, v = "in" }.
relabelled : boxed = (parcel with { v = "out" }).
content : string -> rel.
content relabelled.v.

%use "std/graph".
city : type.  a : city.  b : city.  c : city.
road : city -> city -> rel.
road a b.  road b c.
rail : city -> city -> rel.
rail c a.
g : graph = { node = city, edge = road }.
byRail = tc (g with { edge = rail }).
reach : city -> city -> rel.
reach X Y :- byRail.path X Y.

item : type = { name : string, price : int }.
item "pen" 2.
sale : item -> rel.
sale (I with { price = 1 }) :- item N P, I = item N P.
%output at. %output content. %output reach. %output sale.
