{
  "name": "hugin",
  "displayName": "Hugin",
  "description": "Syntax highlighting and language server support for Hugin, a two-level typed Datalog",
  "version": "0.1.0",
  "publisher": "hugin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/k0uks1/hugin"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hugin",
        "aliases": [
          "Hugin",
          "hugin"
        ],
        "extensions": [
          ".hgn",
          ".facts"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hugin",
        "scopeName": "source.hugin",
        "path": "./syntaxes/hugin.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Hugin",
      "properties": {
        "hugin.server.path": {
          "type": "string",
          "default": "hugin",
          "description": "The `hugin` executable that runs the language server (`hugin lsp`): a command on the PATH or an absolute path, e.g. `<checkout>/bin/hugin`."
        },
        "hugin.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Hugin language server (in the output channel `Hugin`)."
        },
        "hugin.inlayHints.staging": {
          "type": "boolean",
          "default": true,
          "description": "Show the quotes `⟨ ⟩`, splices `$` and lifts `⇑` that stage inference inserted, as inlay hints."
        },
        "hugin.inlayHints.implicits": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred implicit arguments `{A}` of applications, as inlay hints."
        },
        "hugin.inlayHints.levels": {
          "type": "boolean",
          "default": false,
          "description": "Show the inferred universe levels of `Type`, as inlay hints."
        }
      }
    },
    "commands": [
      {
        "command": "hugin.showExpansion",
        "title": "Show Expansion",
        "category": "Hugin"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hugin.showExpansion",
          "when": "editorLangId == hugin",
          "group": "navigation"
        }
      ]
    },
    "semanticTokenModifiers": [
      {
        "id": "meta",
        "description": "A name or syntax of the meta level (evaluated at compile time)."
      },
      {
        "id": "object",
        "description": "A name of the object level (Datalog)."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "hugin",
        "scopes": {
          "label": [
            "keyword.other.hole.hugin"
          ],
          "*.meta": [
            "meta.level.meta.hugin"
          ],
          "*.object": [
            "meta.level.object.hugin"
          ]
        }
      }
    ]
  },
  "scripts": {
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
