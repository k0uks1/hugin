(* Section 13.1: graph operations. The signature `graph` and the functors `tc` and `bounded` come from
   the prelude (src/main/resources/hugin/stdlib/prelude.hgn). *)
%use "std/graph".
city : type.
berlin : city.
paris : city.
rome : city.
road : city -> city -> rel.
%input road.

road berlin paris.
road paris rome.
road rome berlin.

roads = tc { node = city, edge = road }.
short = bounded { node = city, edge = road } 5.

from_berlin : city -> rel.
@q from_berlin C :- roads.path berlin C.
%output from_berlin.
%output short.hop.
