(* A function whose clause uses an undefined name: `pick` is dropped (E0101), and so are the uses of
   it, also through `grow`, which was elaborated against it (issue #121): the query is left out without
   a further error, and `twenty`, used only there, is unused. Before, `grow` built stuck code with an
   exponential tree (issue #108; now `e0909_stuck_postulate`). *)
pick : bool -> A -> A -> A.
pick B X Y = choose B X Y. (*~ E0101 *)
first : list int -> int.
first [] = 0.
first (X :: Xs) = X.
nat : Type.
zero : nat.
suc : nat -> nat.
twenty : nat = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))). (*~ W0003 *)
grow : nat -> list int -> list int.
grow zero R = R.
grow (suc N) R = grow N (pick true (first R :: R) R).
size : list int -> int.
size [] = 0.
size (X :: Xs) = size Xs + 1.
measured : int -> rel.
measured (size (grow twenty [1])).
