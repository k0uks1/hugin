(* Quoted patterns are constructor patterns: their clauses must cover every case, and recursion must be
   structural. *) %use "std/reflect".
typed : int -> rel.

guard : rule -> list rule. (*~ E0911 *)
guard '( typed $E :- $..Body ) = [].

loop : formula -> int. (*~ E0912 *)
loop '( typed $E ) = loop '( typed $E ).
loop _ = 0.
