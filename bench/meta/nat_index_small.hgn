(* bench: nat_index scaled down to sizes that the unary representation before #131 finishes on the
   JVM's default 1 MiB thread stack: `fin`, `vec` and an equation at indices near 200. *)
fin : nat -> Type.
fz : fin (N + 1).
fs : fin N -> fin (N + 1).
vec : Type -> nat -> Type.
vnil : vec A 0.
vcons : A -> vec A N -> vec A (N + 1).
vhead : vec A (N + 1) -> A.
vhead (vcons X _) = X.
eqn : nat -> nat -> Type.
refl : eqn N N.
x1 : fin 200 = fs (fs (fs fz)).
x2 : fin 199 = fs (fs fz).
x3 : fin 198 = fs fz.
h1 : vec int 200 -> int.
h1 V = vhead V.
h2 : vec int 199 -> int.
h2 V = vhead V.
h3 : vec int 198 -> int.
h3 V = vhead V.
e1 : eqn 200 200 = refl.
e2 : eqn 199 199 = refl.
e3 : eqn 198 198 = refl.
ok : int -> rel.
ok 1.
%output ok.
