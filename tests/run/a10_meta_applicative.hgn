(* A.2 (10): two applications of a module-producing function yield distinct relations;
   two uses of a family at the same type yield one instance *)
graph : mod = { node : type, edge : node -> node -> rel }.
tc (g : graph) = {
  path : g.node -> g.node -> rel.
  path X Y :- g.edge X Y.
  path X Z :- g.edge X Y, path Y Z.
}.
city : type.  berlin : city.  paris : city.
road : city -> city -> rel.
road berlin paris.
r1 = tc { node = city, edge = road }.
r2 = tc { node = city, edge = road }.

box A : type.
put : A -> box A.
a : box int -> rel.
b : box int -> rel.
a (put 1).
b (put 1).
same : rel.
same :- a X, b X.
%output r1.path. %output r2.path. %output same.
