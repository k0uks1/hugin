(* An imported file ascribed with a signature (an interface): only the signature's fields are visible,
   types stay transparent (`s.shape` is the file's `shape`), constructor fields build terms from object
   variables, and a constant also serves as a value field. Every constructor is a fact constructor,
   whose facts can be read. *)
shapes_sig : Type = { shape : type, dot : shape, square : int -> shape, area : shape -> int -> rel }.
s : shapes_sig = %import "lib/shapes".

sizes : int -> rel.
sizes 2. sizes 3. sizes 5.

known : int -> int -> rel.
known N A :- sizes N, s.area (s.square N) A.
%output known.

small : s.shape -> rel.
small s.dot.
small (s.square 2).
?- small X, s.area X A.

marks_sig : Type = { shape : type, mark : int -> shape, plain : int -> shape }.
m : marks_sig = %import "lib/marks".
data_sig : Type = { shape : type, mark : int -> shape }.
d : data_sig = %import "lib/marks".
marked : int -> rel.
marked N :- m.mark N.
%output marked.
?- m.mark N, X = d.mark N.
plains : m.shape -> rel.
plains (m.plain 7).
%output plains.

(* inside a functor, a constructor field can be read *)
counter (c : { shape : type, mark : int -> shape, %complete mark }) = {
  marks : int -> rel.
  marks K :- K = count { N | c.mark N }.
}.
mc = counter m.
%output mc.marks.
