(* ---------------- after elaborate ---------------- *)
fib : nat -> nat.
  fib 0 = 0.
  fib 1 = 1.
  fib (N + 2) = plus (fib N) (fib (N + 1)).
double : nat -> nat.
  double 0 = 0.
  double (N + 1) = double N + 2.
vec : Type -> nat -> Type.
vnil : {A : Type} -> vec A 0.
vcons : {A : Type} -> {N : nat} -> A -> vec A N -> vec A (N + 1).
head : {A : Type} -> {N : nat} -> vec A (N + 1) -> A.
  head (vcons X _) = X.
r : (n : int) -> rel.
r 144.
r 42.
r 7.
?- r N.
?- r N.
N = 144.
N = 42.
N = 7.
