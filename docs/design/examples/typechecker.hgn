(* A type checker over shared syntax (issues #52, #80). The syntax of the simply typed lambda calculus
   is declared once, as shared data types: each is a meta inductive family (whose values a meta function
   builds and checks at compile time) and an object family (whose terms are facts that the relation
   `typed` checks at run time). A program built at compile time is stated as a fact directly
   (`program idf.`: `expr.lift` is inserted). Before #80 the syntax was declared twice, with conversion
   functions between the stages and a local `maybe` type; now only the two checkers remain, and they are
   different programs on purpose (rules with demand, and a total function returning an `option`).

   The file has a module-wide directive (`%demand`), so its rules are reified before they are elaborated;
   the meta values in them are evaluated and reified as their object constructors (#79). *)

expr : data.  ref : string -> expr.  lam : string -> typ -> expr -> expr.  app : expr -> expr -> expr.
typ  : data.  base : string -> typ.  arrow : typ -> typ -> typ.
ctx  : data.  empty : ctx.  bind : ctx -> string -> typ -> ctx.

(* The object checker, as in examples/typechecker.hgn. *)
lookup : (g : ctx) -> (x : string) -> (t : typ) -> rel.
%demand lookup +g +x -t.
lookup (bind _ X T) X T.
lookup (bind G Y _) X T :- lookup G X T, X <> Y.

typed : (e : expr) -> (g : ctx) -> (t : typ) -> rel.
%demand typed +e +g -t.
typed (ref X) G T :- lookup G X T.
typed (lam X T1 B) G (arrow T1 T2) :- typed B (bind G X T1) T2.
typed (app F A) G T1 :- typed F G (arrow T0 T1), typed A G T0.

program : expr -> rel.
result : (e : expr) -> (t : typ) -> rel.
result E T :- program E, typed E empty T.

(* The checker as a meta function, over the meta side of the same types. *)
teq : typ -> typ -> bool.
teq (base A) (base B) = same A B.
teq (arrow A B) (arrow C D) = band (teq A C) (teq B D).
teq A B = false.

mlookup : ctx -> string -> option typ.
mlookup empty X = none.
mlookup (bind G Y T) X = pickT (same X Y) T (mlookup G X).

pickT : bool -> typ -> option typ -> option typ.
pickT true T M = some T.
pickT false T M = M.

infer : ctx -> expr -> option typ.
infer G (ref X) = mlookup G X.
infer G (lam X T B) = arrowOf T (infer (bind G X T) B).
infer G (app F A) = applyT (infer G F) (infer G A).

arrowOf : typ -> option typ -> option typ.
arrowOf T none = none.
arrowOf T (some U) = some (arrow T U).

applyT : option typ -> option typ -> option typ.
applyT (some (arrow A B)) (some C) = checkArg (teq A C) B.
applyT F A = none.

checkArg : bool -> typ -> option typ.
checkArg true B = some B.
checkArg false B = none.

(* Test programs built at compile time; `twice N` is ill typed for N > 0, and both checkers say so. *)
nat : Type.  zero : nat.  suc : nat -> nat.
o : typ = base "o".
idf : expr = lam "x" o (ref "x").
twice : nat -> expr.
twice zero = idf.
twice (suc N) = lam "f" (arrow o o) (app (ref "f") (app (twice N) (ref "f"))).

(* The meta checker's verdict, as a fact, and the object checker's answers on the lifted programs. *)
okAtCompileTime : option typ -> int.
okAtCompileTime none = 0.
okAtCompileTime (some T) = 1.
static_ok : int -> rel.
static_ok (okAtCompileTime (infer empty (twice 2))).

program idf.
program (twice 1).
%output static_ok.
%output result.
