(* A stray token between `as` and its variable: one error, the token and the variable are skipped, and
   the parenthesis closes the pattern; the rule is damaged, the items after it are elaborated. *)
pen : type = { price : int }.
ink : type = { price : int }.
stock : (s : pen | ink) -> rel.
pen 3. ink 5.
stock P :- (pen _ as P).
stock P :- (ink _ as { P). (*~ E0001 *)
?- stock S.
