(* head constructor terms that take finitely many values are not constructive (issue #1, F3): a ground
   term (`red`, `wrap nil`) is one fixed term, and `mk Y` with `Y` bound by the plain relation `b` outside
   the component ranges over the facts of `b`; no `%terminates` is needed *)
color : type. red : color. green : color.
box : type. mk : int -> box. wrap : list int -> box.
b : int -> rel. b 1. b 2.
d : int -> color -> rel.
d X green :- b X.
d X red :- d X _.
e : int -> box -> rel.
e 0 (wrap nil).
e X (mk Y) :- e X _, b Y.
e Y B :- e _ B, b Y.
%output d. %output e.
