hugin> (* Started as `hugin repl examples/graphs.hgn`. *)
hugin> ?- from_berlin C.
C = berlin.
C = paris.
C = rome.
hugin> :type roads
meta definition roads : { path : ⇑(city -> city -> rel) }
hugin> :type roads.path
relation roads.path : city -> city -> rel
hugin> :type short.hop
relation short.hop : city -> city -> int -> rel
hugin> :type tc
meta definition tc : (g : { node : type, edge : ⇑(node -> node -> rel) }) -> { path : ⇑(g.node -> g.node -> rel) }
hugin> :kind tc
tc : meta definition
hugin> :type tc { node = city, edge = road }
tc { node = city, edge = road } : { path : ⇑(city -> city -> rel) }
hugin> :print lower from_berlin
(* ---------------- after lower ---------------- *)
rule  @q from_berlin C :- roads.path berlin C.
  Scan roads.path [0 := r0] [1 := r1]
  Deref r0 berlin
  Insert from_berlin(r1)
