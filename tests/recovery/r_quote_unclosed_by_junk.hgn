(* An entry of a quote whose junk runs to the end of the line (an unterminated string here) takes the
   quote's `)` with it: the quote ending unclosed is the same mistake, not another error. The string
   would take annotations on its line with it: they are on the next line. *)
%use "std/reflect".
node : type. a : node. b : node. c : node.
edge : (src : node) -> (dst : node) -> rel.
link : quoted node -> quoted node -> quoted edge.
link X Y = '( edge $X $Y ).
$'( $(link '( a ) '( b )). $(link '( b ) ' "( c )). ).
blocked : node -> rel. (*~^ E0001 *) (*~^ E0002 *)
blocked a.
