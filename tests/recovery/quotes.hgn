(* Quotes: the rule syntax of old in parentheses is an error with the quote syntax as help, an unclosed
   `'{` is E0005, and the items around them are elaborated. *)
p : int -> rel.
q : int -> rel.
old : rule = (p X :- q X). (*~ E0001 *)
inList : list rule = [p X :- q X]. (*~ E0001 *)
fine : rule = '{ p X :- q X }.
unclosed : rule = '{ p X :- q X (*~ E0005 *)
after : rule = '{ q 1 }.
$[fine, after].
q 2.
