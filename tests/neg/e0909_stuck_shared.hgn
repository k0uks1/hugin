(* Stuck meta code that shares a value (issue #108): `undecided` is a postulate, so `pick undecided R R`
   and `first R` do not reduce, and each level of `grow` refers to the level below twice and splits on
   it. The value has linear size but an exponential tree; compilation reports it at once and shows it in
   part. *)
undecided : bool.
pick : bool -> A -> A -> A.
pick true X Y = X.
pick false X Y = Y.
first : list int -> int.
first [] = 0.
first (X :: Xs) = X.
nat : Type.
zero : nat.
suc : nat -> nat.
twenty : nat = suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))))))))))).
grow : nat -> list int -> list int.
grow zero R = R.
grow (suc N) R = grow N (pick undecided (first R :: R) R).
size : list int -> int.
size [] = 0.
size (X :: Xs) = size Xs + 1.
measured : int -> rel.
measured (size (grow twenty [1])). (*~ E0909 *)
