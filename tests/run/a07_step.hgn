(* A.2 (7), after %partial was removed (reference: object/termination): a counter with an upper bound needs no
   annotation; it terminates by descent along derivations (A), read upwards: `M` is larger than `N` and
   bounded by the guard `N < 6`. *)
step : int -> rel.
step 0.
step M :- step N, N < 6, M = N + 1.
%output step.
