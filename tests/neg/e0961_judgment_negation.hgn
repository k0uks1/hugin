(* A judgment over a program with a negation or an aggregate is its stratum-local judgment, `nderives` of
   `std/strata` (#186 P9c): in a file that does not load `std/strata`, it is E0961, never `derives`, the
   positive fragment in which such a rule never fires. Read as `derives`, `never` would be accepted
   although the run derives `m.ok berlin` (with `std/strata`, tests/neg/p9c_never.hgn). *)
%use "std/semantics".
%use "std/eq" (empty).
city : type. berlin, paris : city.

m = {
  node : city -> rel.
  bad : city -> rel.
  node berlin. node paris. bad paris.
  ok : city -> rel.
  ok X :- node X, not bad X.
}.
never : m ⊢ ok berlin -> empty. (*~ E0961 *)
never (fire {xs := econs X enil} (there (there (there here))) (ppos _ _ ()) here).

n = {
  node : city -> rel.
  node berlin. node paris.
  size : int -> rel.
  size N :- N = count { X | node X }.
}.
counted : {k : int} -> n ⊢ size k -> Type. (*~ E0961 *)
counted _ = Type.

(* a positive program keeps the notation, `derives`, without `std/strata` *)
p = { node : city -> rel. node berlin. }.
same : p ⊢ node berlin -> p ⊢ node berlin.
same P = P.

(* also a functor applied to a variable, whose rule negates a (complete) parameter relation *)
%use "std/graph".
loops (g : complete_graph) = {
  free : g.node -> rel.
  free X :- g.edge X _, not g.edge X X.
}.
looping : {x : G.node} -> loops G ⊢ free x -> Type. (*~ E0961 *)
looping _ = Type.
