(* A probe that an ordinary head builds later becomes a fact (and enters the delta like any new fact) *)
shape : type.
%fact square : int -> shape.

area : (s : shape) -> (a : int) -> rel.
%mode area +s -a.
area (square N) A :- A = N * N.

q : int -> rel.
q A :- area (square 4) A.

made : shape -> rel.
made (square 4) :- q _.
made (square 2) :- q _.

after : int -> rel.
after N :- made (square N), square N.
%output after.
