hugin> (* Declarations and rules are added one input at a time. *)
hugin> node : type. a : node. b : node. c : node.
hugin> edge : node -> node -> rel.
hugin> edge a b. edge b c.
hugin> path : node -> node -> rel.
hugin> path X Y :- edge X Y.
hugin> (* An item continues until its period; periods in comments and strings do not count. *)
hugin> path X Z :-
  ...    edge X Y, (* first a step. then the rest. *)
  ...    path Y Z.
hugin> ?- path a X.
X = b.
X = c.
hugin> (* A rejected input leaves the session unchanged; diagnostics point into the input. *)
hugin> reach : node -> rel.
hugin> reach X :-
  ...    path a X,
  ...    goal X.
error[E0101]: unresolved name `goal`
 --> <input 9>:3:3
  |
3 |   goal X.
  |   ^^^^ not found in this scope

hugin> reach X :- path a X.
hugin> ?- reach X.
X = b.
X = c.
hugin> (* Several items, and queries, on one line. *)
hugin> label : node -> string -> rel. label a "a. b." . ?- label N L.
N = a, L = "a. b.".
hugin> ?- path c X. ?- path X c.
?- path c X.
no.
?- path X c.
X = a.
X = b.
hugin> (* A warning is reported once, for the input that has it; unused definitions are not reported. *)
hugin> never : node -> prop.
warning[W0005]: formula function `never` has no clauses
 --> <input 14>:1:1
  |
1 | never : node -> prop.
  | ^^^^^ always false

hugin> to : node -> rel. to Y :- edge _ Y.
hugin> start : node = a.
hugin> ?- path start X.
X = b.
X = c.
hugin> (* Comments may span lines;
  ...     the input continues until they are closed. *)
hugin> (* An input that breaks earlier text is rejected too. *)
hugin> p : rel. q : rel. p :- q.
hugin> q :- not p.
error[E0601]: stratification cycle through negation
 --> <input 19>:1:6
  |
1 | q :- not p.
  |      ^^^^^ `q` depends negatively on `p`
 ::> <input 18>:1:24: `p` depends on `q`
  |
  = note: cycle: q -> not p -> q
  = note: negation and aggregation must not occur in a recursive cycle (Section 6.4)

hugin> :type path
relation path : node -> node -> rel
hugin> :type a
constructor a : node
hugin> :type cons a nil
cons a nil : cons[node]
hugin> :type 1 + 2
1 + 2 : int
hugin> :type cons nothing nil
error[E0101]: unresolved name `nothing`
 --> <input>:1:6
  |
1 | cons nothing nil
  |      ^^^^^^^ not found in this scope

hugin> :type nothing
error[E0101]: unresolved name `nothing`
 --> <input>:1:1
  |
1 | nothing
  | ^^^^^^^ not found in this scope

hugin> :kind edge
edge : relation
hugin> ?- path X X.
no.
hugin> edge c a.
hugin> ?- path X X.
X = a.
X = b.
X = c.
hugin> :list
node : type. a : node. b : node. c : node.
edge : node -> node -> rel.
edge a b. edge b c.
path : node -> node -> rel.
path X Y :- edge X Y.
path X Z :-
  edge X Y, (* first a step. then the rest. *)
  path Y Z.
reach : node -> rel.
reach X :- path a X.
label : node -> string -> rel. label a "a. b." .
never : node -> prop.
to : node -> rel. to Y :- edge _ Y.
start : node = a.
p : rel. q : rel. p :- q.
edge c a.
hugin> :print records path
(* ---------------- after records+disjunction ---------------- *)
path : node -> node -> rel.
path X Y :- edge X Y.
path X Z :- edge X Y, path Y Z.
reach X :- path a X.
hugin> :stats on
statistics: on
hugin> ?- path a c.
yes.
(* {path}: 3 round(s) *)
hugin> :stats off
statistics: off
hugin> :explain W0005
W0005: formula function without clauses

A formula function is declared without clauses or definition; it is always false.
hugin> :lod x
error: unknown command `:lod`
  = help: did you mean `:load`?
  = help: the commands are :load :reload :facts :reset :type :kind :list :imports :print :explain :stats :help :quit (see :help)

hugin> :reset
session cleared
hugin> ?- path a X.
error[E0101]: unresolved name `path`
 --> <input 1>:1:4
  |
1 | ?- path a X.
  |    ^^^^ not found in this scope

