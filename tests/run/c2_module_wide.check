(* ---------------- after stage ---------------- *)
bool : type.
node : type.
true : bool.
false : bool.
a : node.
b : node.
c : node.
d : node.
edge : node -> node -> rel.
path : node -> node -> rel.
edge a b.
edge b c.
path X Y :- edge X Y.
path X Z :- path X Y, edge Y Z.
edge c d.
edge b a.
edge c b.
edge d c.
edge a d.
?- path d X.

?- path d X.
X = a.
X = b.
X = c.
X = d.
