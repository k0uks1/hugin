(* A.2 (6): the termination check accepts the prelude's `len` (moded `+l -n`, structural recursion on the
   given list: `%terminates l len`) and a bounded integer counter *)
counter : int -> rel.
%terminates N (counter N).
counter 0.
counter M :- counter N, N < 5, M = N + 1.

words : list string -> rel.
words (cons "a" (cons "b" nil)).
?- words L, len L N.
?- len (cons "b" nil) N.
?- len (cons "c" nil) N.            (* `len` is moded: it computes the length of any list it is given *)
?- counter N.
