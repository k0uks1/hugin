(* Reachability at both stages (issues #52, #80). The graph is one value, a list of edges of the shared
   type `edge`, used at compile time by a meta function and at run time as facts: stating it as a fact
   (`known graph.`, `list.lift` is inserted) builds its subfacts, among them the edges `e 1 2`, …, which
   the relation `road` reads. The two definitions of reachability stay different, on purpose: at the
   object level it is the least fixed point of two rules (the functor `tc` of `std/graph`); at the meta level
   a function must be structurally recursive, so the closure is computed by iterating a step a bounded
   number of times (the number of edges suffices), with `iterate` of `std/list`. Before #80 the graph was
   written twice (as facts of `road` and as a list of a meta type `medge`). *)
%use "std/graph". %use "std/list".

edge : data.
e : (from : int) -> (to : int) -> edge.

graph : list edge = [e 1 2, e 2 3, e 3 1, e 4 5].

(* The object definition. *)
known : list edge -> rel.
known graph.
road : int -> int -> rel.
road X Y :- e X Y.
roads = tc { node = int, edge = road }.

(* The meta definition over the same graph, on `std/list`: the fuel `nat` (one step per edge
   suffices), `iterate`, and the list functions. *)
step : list edge -> list int -> list int.
step G R = foldl ([acc] [x] if (elem x acc) acc (x :: acc)) R (concat (map (targets R) G)).

(* the target of an edge whose source is reached *)
targets : list int -> edge -> list int.
targets R (e A B) = if (elem A R) ([B]) [].

(* the nodes reachable from X by a path of at least one edge *)
reach : list edge -> int -> list int.
reach G X = iterate (size G) (step G) (step G [X]).

static_reach : int -> rel.
static_reach (length (reach graph 1)).
dynamic_reach : int -> rel.
dynamic_reach N :- N = count { Y | roads.path 1 Y }.
%output static_reach.
%output dynamic_reach.
