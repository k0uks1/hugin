(* A stray `"` whose text up to the end of the line closes a delimiter opened before it on the line: the
   `"` alone is the error (E0002), and the rest of the line is read as code, so the definition keeps its
   body, and the quote its `)`. *)
%use "std/reflect".
item : (name : string) -> (price : int) -> rel.
listed : item -> rel.
%input listed.
select (p : A -> prop) ( "r : A -> rel) = { (*~ E0002 *)
  sel : A -> rel.
  @s sel X :- r X, p X.
}.
bargains = select ([I] I.price < 10) listed.
%output bargains.sel.
node : type. a : node. b : node. c : node.
edge : (src : node) -> (dst : node) -> rel.
link : quoted node -> quoted node -> quoted edge.
link X Y = '( edge $X $Y ).
$'( $(link '( a ) '( b )). $(link '( b ) ' "( c )). ).
blocked : node -> rel. (*~^ E0001 *) (*~^ E0002 *)
blocked a.
