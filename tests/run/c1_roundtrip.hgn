(* Round trip (reference: reflection): rules quoted as data and reflected back are the rules written
   directly, up to the names of aggregate variables (`ReflectionSuite` compares them). Every form of
   reflective data occurs. *)
n : type.
z : n.
s : n -> n.
num : n -> rel.
p : n -> int -> rel.
q : int -> string -> rel.
r : int -> rel.
w : float -> rel.

data : module = [
  (num z :-),
  (num (s X) :- X = z, not w 2.0),
  (q K "x" :- p _ K, K >= 1, K <= 2 ; K = -1 * 2 + 4 / 2 - (0 - 1)),
  (r N :- N = count { X | num X }),
  (r M :- M = sum { K * 2 | p _ K }, M <> 0),
  (p X 1 :- num X, X = z),
  (w 1.5 :-),
  (p (s z) 2 :- num (s z))
].
$data.

?- q K S.
