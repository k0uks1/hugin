vnil : {A : Type} -> vec A zero.
vcons : {A : Type} -> {N : nat} -> A -> vec A N -> vec A (suc N).
head : {A : Type} -> {N : nat} -> vec A (suc N) -> A.
  head (vcons X _) = X.
append : {A : Type} -> {N : nat} -> {M : nat} -> vec A N -> vec A M -> vec A (plus N M).
  append vnil YS = YS.
  append (vcons X XS) YS = vcons X (append XS YS).
fibm : nat -> int.
  fibm zero = 0.
  fibm (suc zero) = 1.
  fibm (suc (suc N)) = fibm N + fibm (suc N).
