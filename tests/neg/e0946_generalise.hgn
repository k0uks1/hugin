(* A functor written alone before `⊢` is an error (E0946): a judgment names its program, and no parameter
   of a functor is bound by the functor's name for it. The help applies the functor to a variable named
   after its parameter, `tc G ⊢ …`, which the type of a declaration binds as any free uppercase variable
   (#186 P7c). Alone in a type, alone in a definition's body, and alone where the statement also names its
   graph. *)
%use "std/graph".
%use "std/semantics".
alone : {x : G.node} -> tc ⊢ path x x. (*~ E0946 *)
inside (h : graph) (x : h.node) : Type = tc ⊢[D] path x x. (*~ E0946 *)
mixed : {x : G.node} -> tc G ⊢ path x x -> tc ⊢ path x x. (*~ E0946 *)
